# Reduced to exercise cluster-vessel symmetry obstruction.
vars: {
  d2-config: {
  }
}
dram: |md
    1 GiB of DDR3
|
dram.shape: rectangle
Mocha: {
    CVA6-CHERI {
    }
    axi: |md
        #### AXI crossbar
    |
    tlul: |md
        32-bit width
    |
    axi <-> Tag control
    axi <-> Debug
    axi <-> SRAM
    Peripherals {
        rom: |md
            #### ROM
        |
        entropy: |md
            Source
        |
        kmac: |md
            SHA3
        |
        managers: |md
            - Power
        |
    }
}
chip: |md
    #### Rest of chip
    64-bit bus
|
Mocha.Tag control <-> dram
Mocha.axi <-> chip
Mocha.Mailbox <-> chip
Legend {
}
Legend <-> Mocha.CVA6-CHERI {
    style: {
    }
}
