{
  "description": "Single-paragraph inline paint per available width.",
  "segments": [
    {
      "prefix": "paragraph",
      "const": {},
      "axes": [
        {"fields": ["Family"], "values": [["sans"], ["mono"], ["hand"]], "labels": ["sans", "mono", "hand"]},
        {"fields": ["FontSize"], "values": [[12], [16], [22]], "labels": ["12", "16", "22"]},
        {"fields": ["Width"], "values": [[25], [65], [120], [270]], "labels": ["25", "65", "120", "270"]}
      ],
      "snippets": [
        ["00", "**key, type, target**\n**cardinality, identities**"],
        ["01", "hello world end"],
        ["02", "**one two** *three four* end"],
        ["03", "a**bc**def gh"],
        ["04", "[long linked words](https://example.com) end"],
        ["05", "`long code words` end"],
        ["06", "before `abc` after"],
        ["07", "~~one two three~~ end"],
        ["08", "<code>a<b>b c</b>d</code> tail"],
        ["09", "`ab` `cd`"],
        ["10", "abcd­efgh ij"],
        ["11", "ab cd ef"],
        ["12", "甲乙丙丁，天地。"],
        ["13", "abcdéfgh end"],
        ["14", "αβγδε words"],
        ["15", "a  \nb"],
        ["16", "a<br/>b words"],
        ["17", "left  **bold**  right"],
        ["18", "**foo**\n*bar*"],
        ["19", "abcdefghijklmno"]
      ]
    },
    {
      "prefix": "code-span",
      "const": {},
      "axes": [
        {"fields": ["Family"], "values": [["sans"], ["mono"], ["hand"]], "labels": ["sans", "mono", "hand"]},
        {"fields": ["FontSize"], "values": [[12], [16], [22]], "labels": ["12", "16", "22"]},
        {"fields": ["Width"], "values": [[5], [25], [65], [120], [270]], "labels": ["5", "25", "65", "120", "270"]}
      ],
      "snippets": [
        ["00", "<code></code>"],
        ["01", "<code></code> tail"],
        ["02", "before <code></code> after"],
        ["03", "<code> </code> tail"],
        ["04", "<code>\t</code> tail"],
        ["05", "<code><b></b></code> tail"],
        ["06", "<b><code></code></b> tail"],
        ["07", "<em><code></code></em> tail"],
        ["08", "[<code></code>](https://example.com)"],
        ["09", "[<code>abc</code>](https://example.com)"],
        ["10", "before [<code>abc def</code>](https://example.com) after"],
        ["11", "<code>a</code><code></code><code>b</code>"],
        ["12", "<code>a<b>b c</b>d</code> tail"],
        ["13", "<code>a<em>b c</em>d</code> tail"],
        ["14", "<code></code><code></code>"],
        ["15", "~~<code></code>~~ tail"],
        ["16", "[**`code`**](https://example.com)"],
        ["17", "[~~`code`~~](https://example.com)"],
        ["18", "<code>甲乙</code> tail"],
        ["19", "`ab` `cd`"]
      ]
    },
    {
      "prefix": "code-owner",
      "const": {},
      "axes": [
        {"fields": ["Family"], "values": [["sans"], ["mono"], ["hand"]], "labels": ["sans", "mono", "hand"]},
        {"fields": ["FontSize"], "values": [[12], [16], [22]], "labels": ["12", "16", "22"]},
        {"fields": ["Width"], "values": [[5], [25], [65], [120], [270]], "labels": ["5", "25", "65", "120", "270"]}
      ],
      "snippets": [
        ["00", "[<code></code>](https://example.com \"A & B\")"],
        ["01", "[<code>abc</code>](https://example.com \"A & B\")"],
        ["02", "<code><a href=\"https://example.com\" title=\"inner\">abc</a></code>"],
        ["03", "~~<a href=\"https://example.com\">code</a>~~"],
        ["04", "<a href=\"https://example.com\">~~code~~</a>"],
        ["05", "<del>left <del>middle</del> right</del>"],
        ["06", "[code]()"],
        ["07", "<a title=\"no href\"><code></code>tail</a>"]
      ]
    },
    {
      "prefix": "code-break",
      "const": {},
      "axes": [
        {"fields": ["Family"], "values": [["sans"], ["mono"], ["hand"]], "labels": ["sans", "mono", "hand"]},
        {"fields": ["FontSize"], "values": [[12], [16], [22]], "labels": ["12", "16", "22"]},
        {"fields": ["Width"], "values": [[5], [25], [65], [120], [270]], "labels": ["5", "25", "65", "120", "270"]}
      ],
      "snippets": [
        ["00", "<code>a<br/>b</code> tail"],
        ["01", "<code><br/></code> tail"]
      ]
    }
  ]
}
