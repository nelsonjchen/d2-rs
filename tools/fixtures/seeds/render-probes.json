{
  "comment": "Hand-written D2 sources for scripts/render_probe_fixtures.py (render-probe-* recipes). upstream_source names a pinned upstream file read from the patched tree.",
  "connection-label-fill": [
    {
      "name": "empty",
      "source": "a -> b: \"\" { style.fill: lavender }\n"
    },
    {
      "name": "gradient",
      "source": "a -> b: label { style.fill: \"linear-gradient(red, blue)\" }\n"
    },
    {
      "name": "lavender",
      "source": "a -> b: label { style.fill: lavender }\n"
    },
    {
      "name": "linked",
      "source": "a -> b: label { style.fill: lavender; link: https://example.com }\n"
    },
    {
      "name": "multiline",
      "source": "a -> b: \"first\\nsecond\" { style.fill: lavender }\n"
    },
    {
      "name": "no_fill",
      "source": "a -> b: label\n"
    },
    {
      "name": "opacity",
      "source": "a -> b: label { style.fill: lavender; style.opacity: 0.7 }\n"
    },
    {
      "name": "palette",
      "source": "a -> b: label { style.fill: N5 }\n"
    },
    {
      "name": "transparent",
      "source": "a -> b: label { style.fill: transparent }\n"
    }
  ],
  "sequence-note-references": [
    {
      "name": "note-between",
      "source": "shape: sequence_diagram\na -> b\na: {note: Notice}\nphase: {_.a -> _.b}\n"
    },
    {
      "name": "note-before",
      "source": "shape: sequence_diagram\na: {note: Notice}\na -> b\n"
    },
    {
      "name": "note-after",
      "source": "shape: sequence_diagram\na -> b\na -> b: second\na: {note: Notice}\n"
    },
    {
      "name": "same-line",
      "source": "shape: sequence_diagram; a -> b; a: {note: Notice}; a -> b: second\n"
    },
    {
      "name": "two-notes",
      "source": "shape: sequence_diagram\na -> b\nb: {note: First}\na: {note: Second}\na -> b: again\n"
    },
    {
      "name": "self-before-note",
      "source": "shape: sequence_diagram\na -> a: self\na: {note: Notice}\na -> b\n"
    },
    {
      "name": "repeated-label",
      "source": "shape: sequence_diagram\na: {note: First}\na -> b\na.note: Second\n"
    },
    {
      "name": "glob-object",
      "source": "shape: sequence_diagram\na; b\n*: {child: Notice}\na -> b\n"
    },
    {
      "name": "glob-edge",
      "source": "shape: sequence_diagram\na; b\na -> *\na: {note: Notice}\n"
    },
    {
      "name": "nested",
      "source": "outer: {\nshape: sequence_diagram\na -> b\na: {note: Notice}\nphase: {_.a -> _.b}\n}\n"
    },
    {
      "name": "explicit-edge-after-glob",
      "source": "shape: sequence_diagram\na; b\na -> *\na -> b: explicit\na: {note: Notice}\n"
    },
    {
      "name": "glob-descendant",
      "source": "shape: sequence_diagram\na: {x}\nb: {y}\na.x -> b.*\n"
    },
    {
      "name": "quoted-asterisk",
      "source": "shape: sequence_diagram\na -> \"*\"\n"
    },
    {
      "name": "edge-property",
      "source": "shape: sequence_diagram\na; b\n(a -> b)[0].style.stroke: red\n"
    },
    {
      "name": "imported-variable",
      "source": "vars: {part: {x -> y}}\nshape: sequence_diagram\na: ${part}\na -> b\n"
    },
    {
      "name": "outward-object-scope",
      "source": "shape: sequence_diagram\na -> b\nphase: {_.a.label: A}\n"
    },
    {
      "name": "nested-outward-object-scope",
      "source": "outer: {\nshape: sequence_diagram\na -> b\nphase: {_.a.label: A}\n}\n"
    }
  ],
  "sequence-groups": [
    {
      "name": "parent_scope",
      "source": "shape: sequence_diagram\na -> b\nphase: { a.x -> b.y }\n"
    },
    {
      "name": "child_scope",
      "source": "shape: sequence_diagram\na -> b\nphase: { west: { a -> b }; east: { a -> b } }\n"
    },
    {
      "name": "no_child",
      "source": "shape: sequence_diagram\na -> b\nphase: { _.a -> _.b }\n"
    },
    {
      "name": "nested_grid",
      "source": "shape: sequence_diagram\na -> b\na: { grid-columns: 2; cell: { x -> y }; second: { p -> q } }\n"
    },
    {
      "name": "endpoint",
      "source": "shape: sequence_diagram\na -> phase\nphase: { west: { a -> b } }\n"
    },
    {
      "name": "nesting_power",
      "upstream_source": "e2etests/testdata/files/nesting_power.d2"
    },
    {
      "name": "grid_nested_sequence",
      "source": "grid: {grid-columns: 1; inner: {shape: sequence_diagram; a -> b; phase: {a.x -> b.y}}}\n"
    }
  ],
  "sequence-group-reference": [
    "parent_scope",
    "child_scope",
    "no_child",
    "nested_grid",
    "endpoint",
    "nesting_power"
  ],
  "sequence-render-roles": [
    "child_scope",
    "no_child",
    "parent_scope",
    "grid_nested_sequence"
  ],
  "sequence-group-label-fill": "no_child",
  "sequence-extracted-labels": [
    {
      "name": "root_grid",
      "source": "shape: sequence_diagram\na -> b\na: { grid-columns: 2; cell: { x -> y }; second: { p -> q } }\n"
    },
    {
      "name": "deep_grid",
      "source": "shape: sequence_diagram\na -> b\na: {grid-columns: 1; cell: {nested: {x -> y}}}\n"
    }
  ],
