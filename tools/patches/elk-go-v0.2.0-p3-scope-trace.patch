+func traceGraphScope(arena *layered.LGraphArena, graphIndex int, holder *GraphInfoHolder) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	graph := arena.Graph(holder.LGraph)
+	type tracedLayer struct {
+		Index int   `json:"index"`
+		Nodes []int `json:"nodes"`
+		Ports [][]int `json:"ports"`
+	}
+	layers := make([]tracedLayer, 0, len(holder.CurrentNodeOrder))
+	for index, nodes := range holder.CurrentNodeOrder {
+		ids := make([]int, len(nodes))
+		portsByNode := make([][]int, len(nodes))
+		for nodeIndex, nodeID := range nodes {
+			ids[nodeIndex] = int(nodeID)
+			ports := arena.Node(nodeID).Ports
+			portIDs := make([]int, len(ports))
+			for index, portID := range ports {
+				portIDs[index] = int(portID)
+			}
+			portsByNode[nodeIndex] = portIDs
+		}
+		layers = append(layers, tracedLayer{Index: index, Nodes: ids, Ports: portsByNode})
+	}
+	children := make([]int, len(holder.ChildGraphs))
+	for index, child := range holder.ChildGraphs {
+		children[index] = int(child)
+	}
+	parentGraph := -1
+	if holder.HasParent {
+		parentGraph = int(arena.Graph(arena.Node(*holder.Parent).Graph).ID)
+	}
+	encoded, err := json.Marshal(struct {
+		Stage         string        `json:"stage"`
+		GraphIndex    int           `json:"graph_index"`
+		ArenaGraph    int           `json:"arena_graph"`
+		ParentGraph   int           `json:"parent_graph"`
+		DontSweepInto bool          `json:"dont_sweep_into"`
+		Layers        []tracedLayer `json:"layers"`
+		Children      []int         `json:"children"`
+	}{"p3-graph-scope", graph.ID, int(holder.LGraph), parentGraph, holder.DontSweepInto(), layers, children})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
+
+func traceP3LayerStart(arena *layered.LGraphArena, nodes []layered.LNodeID, preordered, randomized, forward bool) {
+	if os.Getenv("D2_ELK_TRACE") == "" || len(nodes) == 0 {
+		return
+	}
+	node := arena.Node(nodes[0])
+	ids := make([]int, len(nodes))
+	for index, nodeID := range nodes {
+		ids[index] = int(nodeID)
+	}
+	encoded, err := json.Marshal(struct {
+		Stage      string `json:"stage"`
+		GraphIndex int    `json:"graph_index"`
+		Layer      int    `json:"layer"`
+		Preordered bool   `json:"preordered"`
+		Randomized bool   `json:"randomized"`
+		Forward    bool   `json:"forward"`
+		Nodes      []int  `json:"nodes"`
+	}{"p3-layer-start", arena.Graph(node.Graph).ID, arena.Layer(*node.Layer).ID, preordered, randomized, forward, ids})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
