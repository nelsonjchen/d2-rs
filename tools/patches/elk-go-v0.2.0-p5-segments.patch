diff --git a/internal/layered/p5edges/orthogonal/diagnostic_segments_trace.go b/internal/layered/p5edges/orthogonal/diagnostic_segments_trace.go
new file mode 100644
--- /dev/null
+++ b/internal/layered/p5edges/orthogonal/diagnostic_segments_trace.go
@@ -0,0 +1,120 @@
+// Copyright (c) 2010, 2020 Kiel University and others.
+//
