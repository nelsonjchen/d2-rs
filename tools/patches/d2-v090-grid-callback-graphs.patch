+func traceGridExternalEdges(edges []*d2graph.Edge) {
+    if os.Getenv("D2_TRACE_GRID_CALLBACK") == "1" && len(edges) > 0 {
+        graph := edges[0].Src.Graph
+        names := make([]string, 0, len(graph.Objects))
+        for _, object := range graph.Objects { names = append(names, object.AbsID()) }
+        fmt.Fprintf(os.Stderr, "GRID_CALLBACK root=%q nodes=%d edges=%d objects=%q\n", graph.Root.AbsID(), len(graph.Objects), len(graph.Edges), names)
+    }
+
+	ordinals := make(map[string]int)
+	var records []string
+	for _, e := range edges {
+		source := hex.EncodeToString([]byte(normalizedGridTraceID(e.Src.AbsID())))
+		target := hex.EncodeToString([]byte(normalizedGridTraceID(e.Dst.AbsID())))
+		scope := "root"
+		for parent := e.Src.Parent; parent != nil; parent = parent.Parent {
+			if parent.IsGridDiagram() {
+				scope = normalizedGridTraceID(parent.AbsID())
+				if scope == "" {
+					scope = "root"
+				}
+				break
+			}
+		}
+		scopeHex := hex.EncodeToString([]byte(scope))
+		pair := scopeHex + ":" + source + ">" + target
+		ordinal := ordinals[pair]
+		ordinals[pair]++
+		points := make([]string, 0, len(e.Route))
+		for _, point := range e.Route {
+			points = append(points, fmt.Sprintf("%016x,%016x", math.Float64bits(point.X), math.Float64bits(point.Y)))
+		}
+		records = append(records, fmt.Sprintf("GRID_ROUTE stage=external-route scope=%s edge=%s>%s#%d points=%s", scopeHex, source, target, ordinal, strings.Join(points, ";")))
+	}
+	sort.Strings(records)
+	for _, record := range records {
+		fmt.Fprintln(os.Stderr, record)
+	}
+}
