+func traceGridFinal(g *d2graph.Graph) {
+	var records []string
+	objects := append([]*d2graph.Object(nil), g.Objects...)
+	sort.Slice(objects, func(i, j int) bool { return objects[i].AbsID() < objects[j].AbsID() })
+	for _, object := range objects {
+		nodeID := hex.EncodeToString([]byte(normalizedGridTraceID(object.AbsID())))
+		records = append(records, fmt.Sprintf(
+			"GRID_STATE stage=layout-final scope=726f6f74 node=%s rect=%016x,%016x,%016x,%016x",
+			nodeID,
+			math.Float64bits(object.TopLeft.X), math.Float64bits(object.TopLeft.Y),
+			math.Float64bits(object.Width), math.Float64bits(object.Height),
+		))
+		if object.LabelPosition != nil {
+			records = append(records, fmt.Sprintf(
+				"GRID_LABEL stage=layout-final scope=726f6f74 node=%s position=%s",
+				nodeID, *object.LabelPosition,
+			))
+		}
+	}
+	ordinals := make(map[string]int)
+	for _, edge := range g.Edges {
+		source := hex.EncodeToString([]byte(normalizedGridTraceID(edge.Src.AbsID())))
+		target := hex.EncodeToString([]byte(normalizedGridTraceID(edge.Dst.AbsID())))
+		pair := source + ">" + target
+		ordinal := ordinals[pair]
+		ordinals[pair] = ordinal + 1
+		if len(edge.Route) == 0 {
+			continue
+		}
+		points := make([]string, 0, len(edge.Route))
+		for _, point := range edge.Route {
+			points = append(points, fmt.Sprintf("%016x,%016x", math.Float64bits(point.X), math.Float64bits(point.Y)))
+		}
+		records = append(records, fmt.Sprintf(
+			"GRID_ROUTE stage=layout-final scope=726f6f74 edge=%s>%s#%d points=%s",
+			source, target, ordinal, strings.Join(points, ";"),
+		))
+	}
+	sort.Strings(records)
+	for _, record := range records {
+		fmt.Fprintln(os.Stderr, record)
+	}
+}
