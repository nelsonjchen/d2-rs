+// Development-only observer: invoked in declared flavor order, not worker order.
+func traceRouteFlavor(response GenerateRouteResponse) {
+	if os.Getenv("TALA_TRACE_ROUTING") == "" {
+		return
+	}
+	routes := make([]map[string]any, 0, len(response.Routes))
+	for _, route := range response.Routes {
+		points := make([]map[string]string, 0, len(route.OVGNodes))
+		for _, point := range route.OVGNodes {
+			points = append(points, map[string]string{"x_bits": fmt.Sprintf("0x%016x", math.Float64bits(point.X)), "y_bits": fmt.Sprintf("0x%016x", math.Float64bits(point.Y))})
+		}
+		routes = append(routes, map[string]any{"id": route.GEdge.ID, "from": route.GEdge.From.ID, "to": route.GEdge.To.ID, "points": points})
+	}
+	encoded, err := json.Marshal(map[string]any{"event": "route-flavor", "flavor": response.Flavor, "distance_bits": fmt.Sprintf("0x%016x", math.Float64bits(response.Distance)), "routes": routes})
+	if err == nil {
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
+
+func traceAdditionalRoutingCosts(g *layoutgraph.Graph) {
+    if os.Getenv("D2_TRACE_ROUTER_COSTS") != "1" { return }
+    costs := g.RoutingCosts()
+    var snapshot strings.Builder
+    fmt.Fprintf(&snapshot, "ROUTER_COSTS begin nodes=%d edges=%d\n", len(g.Nodes), len(g.Edges))
+    fmt.Fprintf(&snapshot, "ROUTER_COST_VALUES cell=%016x crossing=%016x turn=%016x noncenter=%016x root=%t\n", math.Float64bits(g.CellSize), math.Float64bits(costs.Crossing), math.Float64bits(costs.Turn), math.Float64bits(costs.NonCenterPort), g.IsRootHierarchy)
+    for _, node := range g.Nodes {
+        edges := make([]string, 0, len(node.Edges))
+        for _, edge := range node.Edges { edges = append(edges, fmt.Sprint(edge.ID)) }
+        fmt.Fprintf(&snapshot, "ROUTER_COST_NODE node=%d container=%t hierarchy=%t edges=%s\n", node.IDValue(), node.IsContainer(), node.Hierarchy != nil, strings.Join(edges, ","))
+    }
+    fmt.Fprintln(&snapshot, "ROUTER_COSTS end")
+    fmt.Fprint(os.Stderr, snapshot.String())
+}
