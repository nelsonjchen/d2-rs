+// Diagnostic-only measurements of the constraints used during BK compaction.
+package dagro
+
+import (
+	"fmt"
+	"math"
+	"os"
+)
+
+func traceDagroPositionSeparation(g *Graph, layerIndex, pairIndex int, v, w, vRoot, wRoot string, reverseSep bool, separation, blockDistance float64) {
+	if os.Getenv("DAGRO_TRACE_POS") == "" {
+		return
+	}
+	vAttrs := asAttrs(g.Node(v))
+	wAttrs := asAttrs(g.Node(w))
+	fmt.Fprintf(os.Stderr, "GO_BK_SEP layer=%d pair=%d v=%q w=%q vRoot=%q wRoot=%q vWidthBits=%016x vDummy=%v vLabelpos=%v wWidthBits=%016x wDummy=%v wLabelpos=%v reverseSep=%t separationBits=%016x blockDistanceBits=%016x\n",
+		layerIndex, pairIndex, v, w, vRoot, wRoot,
+		math.Float64bits(num(vAttrs, "width")), positionTruthy(vAttrs["dummy"]), vAttrs["labelpos"],
+		math.Float64bits(num(wAttrs, "width")), positionTruthy(wAttrs["dummy"]), wAttrs["labelpos"],
+		reverseSep, math.Float64bits(separation), math.Float64bits(blockDistance))
+}
