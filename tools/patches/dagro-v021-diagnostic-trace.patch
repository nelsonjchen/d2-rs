+// Diagnostic-only additions for d2-rs; upstream algorithms are unchanged.
+package dagro
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+)
+
+func traceDagroGraph(g *Graph, phase, flag string) {
+	if os.Getenv(flag) == "" {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "GO_DAGRO_PHASE %s\n", phase)
+	for index, v := range g.Nodes() {
+		a := asAttrs(g.Node(v))
+		parent, hasParent := g.Parent(v)
+		fmt.Fprintf(os.Stderr, "GO_DAGRO_NODE index=%d id=%q parent=%q hasParent=%v children=%q rank=%v minRank=%v maxRank=%v order=%v dummy=%v borderType=%v\n", index, v, parent, hasParent, g.Children(v), a["rank"], a["minRank"], a["maxRank"], a["order"], a["dummy"], a["borderType"])
+		for _, key := range []string{"x", "y", "width", "height"} {
+			if value, ok := a[key].(float64); ok {
+				fmt.Fprintf(os.Stderr, "GO_DAGRO_VALUE id=%q field=%s value=%.17g bits=%016x\n", v, key, value, math.Float64bits(value))
+			}
+		}
+	}
+	for _, e := range g.Edges() {
+		a := asAttrs(g.Edge(e))
+		fmt.Fprintf(os.Stderr, "GO_DAGRO_EDGE from=%q to=%q name=%q minlen=%v weight=%v\n", e.V, e.W, e.Name, a["minlen"], a["weight"])
+	}
+}
+
+func traceDagroBKRoots(g *Graph, alignment string, roots map[string]string) {
+	if os.Getenv("DAGRO_TRACE_POS") == "" {
+		return
+	}
+	for _, node := range g.Nodes() {
+		root, ok := roots[node]
+		if ok {
+			fmt.Fprintf(os.Stderr, "GO_BK_ROOT alignment=%s id=%q root=%q\n", alignment, node, root)
+		}
+	}
+}
+
+func traceDagroBKConflicts(g *Graph, kind string, conflicts positionConflicts) {
+	if os.Getenv("DAGRO_TRACE_POS") == "" {
+		return
+	}
+	nodes := g.Nodes()
+	count := 0
+	for firstIndex, first := range nodes {
+		for _, second := range nodes[firstIndex+1:] {
+			if hasConflict(conflicts, first, second) {
+				fmt.Fprintf(os.Stderr, "GO_BK_CONFLICT kind=%s first=%q second=%q\n", kind, first, second)
+				count++
+			}
+		}
+	}
+	fmt.Fprintf(os.Stderr, "GO_BK_CONFLICT_END kind=%s count=%d\n", kind, count)
+}
+
+func traceDagroLayers(phase string, iteration int, layers [][]string) {
+	if os.Getenv("DAGRO_TRACE_ORDER") == "" {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "GO_DAGRO_LAYERS phase=%s iteration=%d layers=%v\n", phase, iteration, layers)
+}
+
+func traceDagroOrderLayers(phase string, iteration int, crossings *float64, layers [][]string) {
+	if os.Getenv("DAGRO_TRACE_ORDER") == "" {
+		return
+	}
+	crossingBits := "none"
+	if crossings != nil {
+		crossingBits = fmt.Sprintf("%016x", math.Float64bits(*crossings))
+	}
+	encoded, err := json.Marshal(layers)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "GO_DAGRE_ORDER_ERROR phase=%s iteration=%d error=%q\n", phase, iteration, err)
+		return
+	}
+	fmt.Fprintf(os.Stderr, "GO_DAGRE_ORDER phase=%s iteration=%d crossings_bits=%s layers=%s\n", phase, iteration, crossingBits, encoded)
+}
+
+func traceDagroPosition(g *Graph, alignment string, xs map[string]float64) {
+	if os.Getenv("DAGRO_TRACE_POS") == "" {
+		return
+	}
+	// Enumerate graph nodes without imposing an order on algorithm maps.
+	for _, v := range g.Nodes() {
+		if x, ok := xs[v]; ok {
+			fmt.Fprintf(os.Stderr, "GO_POS alignment=%s id=%q x=%.17g x_bits=%016x\n", alignment, v, x, math.Float64bits(x))
+		}
+	}
+}
