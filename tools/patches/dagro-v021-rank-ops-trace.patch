+func rankTraceEnabled() bool { return os.Getenv("DAGRO_TRACE_RANK_OPS") != "" }
+
+func rankTraceAliases(g *Graph) map[string]string {
+	aliases := make(map[string]string, g.NodeCount())
+	graphAttrs := asAttrs(g.Graph())
+	root := stringValue(graphAttrs, "nestingRoot")
+	borderIndex := 0
+	for _, id := range g.Nodes() {
+		switch {
+		case id == root && root != "":
+			aliases[id] = "nesting-root"
+		case strings.HasPrefix(id, "_bt"), strings.HasPrefix(id, "_bb"):
+			aliases[id] = fmt.Sprintf("border:%d", borderIndex)
+			borderIndex++
+		default:
+			attrs := asAttrs(g.Node(id))
+			objectID := stringValue(attrs, "id")
+			if objectID == "" {
+				objectID = id
+			}
+			aliases[id] = "object:" + objectID
+		}
+	}
+	return aliases
+}
+
+func rankTraceBits(attrs Attrs, key string) *string {
+	value, ok := attrs[key].(float64)
+	if !ok {
+		return nil
+	}
+	bits := fmt.Sprintf("%016x", math.Float64bits(value))
+	return &bits
+}
+
+func rankTracePair(edge Edge, aliases map[string]string) *rankOpPair {
+	if edge.V == "" && edge.W == "" {
+		return nil
+	}
+	return &rankOpPair{Source: aliases[edge.V], Target: aliases[edge.W]}
+}
+
+func traceRankOperation(g, tree *Graph, phase string, iteration int, leave, enter *Edge) {
+	if !rankTraceEnabled() {
+		return
+	}
+	aliases := rankTraceAliases(g)
+	treeEdgeCount := 0
+	if tree != nil {
+		treeEdgeCount = tree.EdgeCount()
+	}
+	event := rankOpEvent{
+		Phase: phase, Iteration: iteration,
+		Nodes:       make([]rankOpNode, 0, g.NodeCount()),
+		Constraints: make([]rankOpEdge, 0, g.EdgeCount()),
+		Tree:        make([]rankOpEdge, 0, treeEdgeCount),
+		Candidates:  make([]rankOpCandidate, 0),
+		Leave:       rankTraceLeave(leave, aliases),
+		Enter:       rankTracePairOrNil(enter, aliases),
+	}
+	for _, id := range g.Nodes() {
+		attrs := asAttrs(g.Node(id))
+		parent := stringValue(rankTraceNodeAttrs(tree, id), "parent")
+		hasParent := parent != ""
+		var parentID *string
+		if hasParent {
+			alias := aliases[parent]
+			parentID = &alias
+		}
+		event.Nodes = append(event.Nodes, rankOpNode{
+			ID: aliases[id], RankBits: rankTraceBits(attrs, "rank"), Parent: parentID,
+			LowBits: rankTraceBits(rankTraceNodeAttrs(tree, id), "low"),
+			LimBits: rankTraceBits(rankTraceNodeAttrs(tree, id), "lim"),
+		})
+	}
+	for _, edge := range g.Edges() {
+		attrs := asAttrs(g.Edge(edge))
+		event.Constraints = append(event.Constraints, rankOpEdge{
+			Source: aliases[edge.V], Target: aliases[edge.W],
+			MinlenBits: fmt.Sprintf("%016x", math.Float64bits(num(attrs, "minlen"))),
+			WeightBits: fmt.Sprintf("%016x", math.Float64bits(num(attrs, "weight"))),
+		})
+	}
+	if tree != nil {
+		for _, edge := range tree.Edges() {
+			attrs := asAttrs(tree.Edge(edge))
+			cut := rankTraceBits(attrs, "cutvalue")
+			from, to := aliases[edge.V], aliases[edge.W]
+			if to < from {
+				from, to = to, from
+			}
+			event.Tree = append(event.Tree, rankOpEdge{Source: from, Target: to, CutBits: cut})
+		}
+	}
+	if leave != nil {
+		v, w := leave.V, leave.W
+		if !g.HasEdge(v, w) {
+			v, w = w, v
+		}
+		vLabel, wLabel := asAttrs(tree.Node(v)), asAttrs(tree.Node(w))
+		tail := vLabel
+		flip := false
+		if num(vLabel, "lim") > num(wLabel, "lim") {
+			tail, flip = wLabel, true
+		}
+		bestSlack := 0.0
+		found := false
+		for _, candidate := range g.Edges() {
+			vDesc := isDescendant(asAttrs(tree.Node(candidate.V)), tail)
+			wDesc := isDescendant(asAttrs(tree.Node(candidate.W)), tail)
+			eligible := flip == vDesc && flip != wDesc
+			slackValue := slack(g, candidate)
+			event.Candidates = append(event.Candidates, rankOpCandidate{
+				Source: aliases[candidate.V], Target: aliases[candidate.W],
+				Eligible:  eligible,
+				SlackBits: fmt.Sprintf("%016x", math.Float64bits(slackValue)),
+			})
+			if eligible && (!found || slackValue < bestSlack) {
+				bestSlack, found = slackValue, true
+			}
+		}
+	}
+	encoded, err := json.Marshal(event)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "GO_RANK_OP_ERROR phase=%s error=%q\n", phase, err)
+		return
+	}
+	fmt.Fprintf(os.Stderr, "GO_RANK_OP %s\n", encoded)
+}
+
+func rankTraceNodeAttrs(tree *Graph, id string) Attrs {
+	if tree == nil {
+		return nil
+	}
+	return asAttrs(tree.Node(id))
+}
+
+func rankTracePairOrNil(edge *Edge, aliases map[string]string) *rankOpPair {
+	if edge == nil {
+		return nil
+	}
+	return rankTracePair(*edge, aliases)
+}
+
+func rankTraceLeave(edge *Edge, aliases map[string]string) *rankOpPair {
+	pair := rankTracePairOrNil(edge, aliases)
+	if pair != nil && pair.Target < pair.Source {
+		pair.Source, pair.Target = pair.Target, pair.Source
+	}
+	return pair
+}
