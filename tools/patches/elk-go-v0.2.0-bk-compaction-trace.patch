+//go:build d2elkdiagnostic
+
+package p4nodes
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"github.com/d2lang/elk-go/internal/layered"
+)
+
+func traceBKConstraint(
+	arena *layered.LGraphArena,
+	layout *BKAlignedLayout,
+	current, neighbor, root, neighborRoot layered.LNodeID,
+	spacing, position float64,
+) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	encoded, err := json.Marshal(struct {
+		Stage       string  `json:"stage"`
+		Vertical    int     `json:"vertical"`
+		Horizontal  int     `json:"horizontal"`
+		Current     string  `json:"current"`
+		Neighbor    string  `json:"neighbor"`
+		Root        string  `json:"root"`
+		NeighborRoot string `json:"neighbor_root"`
+		CurrentY    float64 `json:"current_y"`
+		NeighborY   float64 `json:"neighbor_y"`
+		Spacing     float64 `json:"spacing"`
+		Position    float64 `json:"position"`
+	}{
+		"bk-spacing-constraint", int(layout.VDirection), int(layout.HDirection),
+		tracedNodeStableID(arena, current), tracedNodeStableID(arena, neighbor),
+		tracedNodeStableID(arena, root), tracedNodeStableID(arena, neighborRoot),
+		requireFloat(layout.Y[arena.Node(root).ID], "y"),
+		requireFloat(layout.Y[arena.Node(neighborRoot).ID], "y"), spacing, position,
+	})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
+
+func traceBKClassConstraint(arena *layered.LGraphArena, layout *BKAlignedLayout, source, target layered.LNodeID, separation float64) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	encoded, err := json.Marshal(struct {
+		Stage      string  `json:"stage"`
+		Vertical   int     `json:"vertical"`
+		Horizontal int     `json:"horizontal"`
+		Source     string  `json:"source"`
+		Target     string  `json:"target"`
+		Separation float64 `json:"separation"`
+	}{"bk-class-constraint", int(layout.VDirection), int(layout.HDirection), tracedNodeStableID(arena, source), tracedNodeStableID(arena, target), separation})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
+
+func traceBKClassShift(arena *layered.LGraphArena, layout *BKAlignedLayout, sink layered.LNodeID, shift float64) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	encoded, err := json.Marshal(struct {
+		Stage      string  `json:"stage"`
+		Vertical   int     `json:"vertical"`
+		Horizontal int     `json:"horizontal"`
+		Sink       string  `json:"sink"`
+		Shift      float64 `json:"shift"`
+	}{"bk-class-shift", int(layout.VDirection), int(layout.HDirection), tracedNodeStableID(arena, sink), shift})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
+
+func traceBKPostProcess(arena *layered.LGraphArena, layout *BKAlignedLayout, free layered.LNodeID, edge layered.LEdgeID, block layered.LNodeID, delta, available, before, after float64) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	encoded, err := json.Marshal(struct {
+		Stage      string  `json:"stage"`
+		Vertical   int     `json:"vertical"`
+		Horizontal int     `json:"horizontal"`
+		Free       string  `json:"free"`
+		Edge       int     `json:"edge"`
+		Block      string  `json:"block"`
+		Delta      float64 `json:"delta"`
+		Available  float64 `json:"available"`
+		Before     float64 `json:"before"`
+		After      float64 `json:"after"`
+	}{"bk-postprocess", int(layout.VDirection), int(layout.HDirection), tracedNodeStableID(arena, free), int(edge), tracedNodeStableID(arena, block), delta, available, before, after})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
