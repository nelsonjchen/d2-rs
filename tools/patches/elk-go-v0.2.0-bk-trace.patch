+
+//go:build d2elkdiagnostic
+
+package p4nodes
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+
+	basegraph "github.com/d2lang/elk-go/internal/graph"
+	"github.com/d2lang/elk-go/internal/layered"
+)
+
+func traceInsideBlockShift(arena *layered.LGraphArena, current, next layered.LNodeID, edgeID layered.LEdgeID, sourcePortID, targetPortID layered.LPortID, direction HorizontalDirection, delta float64) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	source := arena.Port(sourcePortID)
+	target := arena.Port(targetPortID)
+	portStableID := func(portID layered.LPortID) string {
+		port := arena.Port(portID)
+		origin, found := basegraph.TryGet(&port.Properties, layered.OriginalElement)
+		if found && origin.Kind == layered.OriginPort {
+			return fmt.Sprintf("port:%d", origin.Port)
+		}
+		return fmt.Sprintf("lport:%d", portID)
+	}
+	ownerStableID := func(portID layered.LPortID) string {
+		port := arena.Port(portID)
+		if port.Node == nil {
+			return "none"
+		}
+		return tracedNodeStableID(arena, *port.Node)
+	}
+	encoded, err := json.Marshal(struct {
+		Stage string `json:"stage"`
+		Current string `json:"current"`
+		Next string `json:"next"`
+		Edge string `json:"edge"`
+		SourceOwner string `json:"source_owner"`
+		TargetOwner string `json:"target_owner"`
+		SourcePort string `json:"source_port"`
+		TargetPort string `json:"target_port"`
+		SourcePortYBits string `json:"source_port_y_bits"`
+		SourceAnchorYBits string `json:"source_anchor_y_bits"`
+		SourceCenterYBits string `json:"source_center_y_bits"`
+		TargetPortYBits string `json:"target_port_y_bits"`
+		TargetAnchorYBits string `json:"target_anchor_y_bits"`
+		TargetCenterYBits string `json:"target_center_y_bits"`
+		DeltaBits string `json:"delta_bits"`
+		Direction string `json:"direction"`
+	}{"bk-inner-shift", tracedNodeStableID(arena, current), tracedNodeStableID(arena, next), fmt.Sprintf("edge:%d", edgeID), ownerStableID(sourcePortID), ownerStableID(targetPortID), portStableID(sourcePortID), portStableID(targetPortID), fmt.Sprintf("%016x", math.Float64bits(source.Position.Y)), fmt.Sprintf("%016x", math.Float64bits(source.Anchor.Y)), fmt.Sprintf("%016x", math.Float64bits(source.Position.Y+source.Anchor.Y)), fmt.Sprintf("%016x", math.Float64bits(target.Position.Y)), fmt.Sprintf("%016x", math.Float64bits(target.Anchor.Y)), fmt.Sprintf("%016x", math.Float64bits(target.Position.Y+target.Anchor.Y)), fmt.Sprintf("%016x", math.Float64bits(delta)), fmt.Sprintf("%d", direction)})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
