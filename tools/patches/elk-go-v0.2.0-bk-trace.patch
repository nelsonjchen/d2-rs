+
+//go:build d2elkdiagnostic
+
+package p3order
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+
+	"github.com/d2lang/elk-go/internal/layered"
+)
+
+type tracedBarycenter struct {
+	Name        string   `json:"name"`
+	Type        int      `json:"type"`
+	Position    int      `json:"position"`
+	Barycenter  *float64 `json:"barycenter"`
+	SummedWeight float64 `json:"summed_weight"`
+	Degree int `json:"degree"`
+}
+
+func traceBarycenterCandidates(
+	arena *layered.LGraphArena,
+	resolver *ForsterConstraintResolver,
+	nodes []layered.LNodeID,
+	preordered, randomized, forward bool,
+) {
+	if os.Getenv("D2_ELK_TRACE") == "" || len(nodes) == 0 {
+		return
+	}
+	traced := make([]tracedBarycenter, 0, len(nodes))
+	for position, nodeID := range nodes {
+		node := arena.Node(nodeID)
+		name := fmt.Sprintf("dummy:type=%d", node.Type)
+		if len(node.Labels) > 0 {
+			name = arena.Label(node.Labels[0]).Text
+		}
+		state := resolver.state(arena, nodeID)
+		var barycenter *float64
+		if value := state.Barycenter; value != nil {
+			copy := *value
+			barycenter = &copy
+		}
+		traced = append(traced, tracedBarycenter{Name: name, Type: int(node.Type), Position: position, Barycenter: barycenter, SummedWeight: state.SummedWeight, Degree: state.Degree})
+	}
+	encoded, err := json.Marshal(struct {
+		Stage      string              `json:"stage"`
+		Layer      int                 `json:"layer"`
+		Preordered bool                `json:"preordered"`
+		Randomized bool                `json:"randomized"`
+		Forward    bool                `json:"forward"`
+		Nodes      []tracedBarycenter `json:"nodes"`
+	}{"p3-barycenter", int(arena.Layer(*arena.Node(nodes[0]).Layer).ID), preordered, randomized, forward, traced})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
+
+func traceFixedPortRank(arena *layered.LGraphArena, freeID layered.LNodeID, portID layered.LPortID, rank float32, kind PortDistributorKind, forward bool) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	port := arena.Port(portID)
+	fixedID := *port.Node
+	fixedPorts := make([]int, len(arena.Node(fixedID).Ports))
+	for index, fixedPortID := range arena.Node(fixedID).Ports {
+		fixedPorts[index] = int(fixedPortID)
+	}
+	name := func(nodeID layered.LNodeID) string {
+		node := arena.Node(nodeID)
+		if len(node.Labels) > 0 {
+			return arena.Label(node.Labels[0]).Text
+		}
+		return fmt.Sprintf("dummy:type=%d", node.Type)
+	}
+	encoded, err := json.Marshal(struct {
+		Stage string  `json:"stage"`
+		FreeID int    `json:"free_id"`
+		FixedID int   `json:"fixed_id"`
+		Free string  `json:"free"`
+		Fixed string `json:"fixed"`
+		Port int     `json:"port"`
+		FixedPorts []int `json:"fixed_ports"`
+		Side int     `json:"side"`
+		Rank float32 `json:"rank"`
+		Kind int     `json:"kind"`
+		Forward bool `json:"forward"`
+	}{"p3-port-rank", int(freeID), int(fixedID), name(freeID), name(fixedID), int(portID), fixedPorts, int(port.Side), rank, int(kind), forward})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
