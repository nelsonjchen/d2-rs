diff --git a/internal/layered/p4nodes/diagnostic_trace.go b/internal/layered/p4nodes/diagnostic_trace.go
new file mode 100644
--- /dev/null
+++ b/internal/layered/p4nodes/diagnostic_trace.go
@@ -0,0 +1,189 @@
+// Copyright (c) 2015 Kiel University and others.
+//
+// This program and the accompanying materials are made available under the
+// terms of the Eclipse Public License 2.0 which is available at
+// https://www.eclipse.org/legal/epl-2.0/.
+//
+// SPDX-License-Identifier: EPL-2.0
+
+//go:build d2elkdiagnostic
+
+package p4nodes
+
+import (
+	"encoding/json"
+	"fmt"
+	"os"
+
+	basegraph "github.com/d2lang/elk-go/internal/graph"
+	"github.com/d2lang/elk-go/internal/layered"
+)
+
+type tracedNode struct {
+	Index        int          `json:"index"`
+	StableID     string       `json:"stable_id"`
+	Layer        int          `json:"layer"`
+	Type         int          `json:"type"`
+	X            float64      `json:"x"`
+	Y            float64      `json:"y"`
+	Width        float64      `json:"width"`
+	Height       float64      `json:"height"`
+	MarginTop    float64      `json:"margin_top"`
+	MarginBottom float64      `json:"margin_bottom"`
+	Ports        []tracedPort `json:"ports"`
+}
+
+type tracedPort struct {
+	Index   int     `json:"index"`
+	Side    int     `json:"side"`
+	X       float64 `json:"x"`
+	Y       float64 `json:"y"`
+	AnchorX float64 `json:"anchor_x"`
+	AnchorY float64 `json:"anchor_y"`
+}
+
+type tracedCandidateNode struct {
+	Index      int      `json:"index"`
+	Name       string   `json:"name"`
+	StableID   string   `json:"stable_id"`
+	LayerOrder int      `json:"layer_order"`
+	LayerID    int      `json:"layer_id"`
+	Y          *float64 `json:"y"`
+	PlacedY    *float64 `json:"placed_y"`
+	InnerShift *float64 `json:"inner_shift"`
+	BlockSize  *float64 `json:"block_size"`
+	Root       *string  `json:"root"`
+	Align      *string  `json:"align"`
+	RootStableID  *string `json:"root_stable_id"`
+	AlignStableID *string `json:"align_stable_id"`
+}
+
+func tracedNodeName(arena *layered.LGraphArena, nodeID layered.LNodeID) string {
+	node := arena.Node(nodeID)
+	if len(node.Labels) > 0 {
+		return arena.Label(node.Labels[0]).Text
+	}
+	return fmt.Sprintf("dummy:type=%d", node.Type)
+}
+
+func tracedNodeStableID(arena *layered.LGraphArena, nodeID layered.LNodeID) string {
+	node := arena.Node(nodeID)
+	origin, found := basegraph.TryGet(&node.Properties, layered.OriginalElement)
+	if !found {
+		return fmt.Sprintf("lnode:%d", nodeID)
+	}
+	switch origin.Kind {
+	case layered.OriginNode:
+		return fmt.Sprintf("node:%d", origin.Node)
+	case layered.OriginPort:
+		return fmt.Sprintf("port:%d", origin.Port)
+	case layered.OriginEdge:
+		return fmt.Sprintf("edge:%d", origin.Edge)
+	case layered.OriginLabel:
+		return fmt.Sprintf("label:%d", origin.Label)
+	case layered.OriginLEdge:
+		return fmt.Sprintf("edge-segment:%d", origin.LEdge)
+	case layered.OriginLNode:
+		return fmt.Sprintf("lnode:%d", origin.LNode)
+	case layered.OriginLPort:
+		return fmt.Sprintf("lport:%d", origin.LPort)
+	default:
+		return fmt.Sprintf("lnode:%d", nodeID)
+	}
+}
+
+func tracedNodeStableIDPointer(arena *layered.LGraphArena, nodeID *layered.LNodeID) *string {
+	if nodeID == nil {
+		return nil
+	}
+	stableID := tracedNodeStableID(arena, *nodeID)
+	return &stableID
+}
+
+func tracedPlacedY(y, innerShift *float64) *float64 {
+	if y == nil || innerShift == nil {
+		return nil
+	}
+	placed := *y + *innerShift
+	return &placed
+}
+
+func tracedNodeNamePointer(arena *layered.LGraphArena, nodeID *layered.LNodeID) *string {
+	if nodeID == nil {
+		return nil
+	}
+	name := tracedNodeName(arena, *nodeID)
+	return &name
+}
+
+func traceDirectionalLayouts(arena *layered.LGraphArena, graphID layered.LGraphID, layouts []*BKAlignedLayout) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	for candidateIndex, layout := range layouts {
+		nodes := make([]tracedCandidateNode, 0)
+		for layerOrder, layerID := range arena.Graph(graphID).Layers {
+			for _, nodeID := range arena.Layer(layerID).Nodes {
+				node := arena.Node(nodeID)
+				index := node.ID
+				nodes = append(nodes, tracedCandidateNode{
+					Index: int(nodeID), Name: tracedNodeName(arena, nodeID), StableID: tracedNodeStableID(arena, nodeID), LayerOrder: layerOrder, LayerID: int(layerID),
+					Y: layout.Y[index], PlacedY: tracedPlacedY(layout.Y[index], layout.InnerShift[index]),
+					InnerShift: layout.InnerShift[index], BlockSize: layout.BlockSize[index],
+					Root: tracedNodeNamePointer(arena, layout.Root[index]), Align: tracedNodeNamePointer(arena, layout.Align[index]),
+					RootStableID: tracedNodeStableIDPointer(arena, layout.Root[index]),
+					AlignStableID: tracedNodeStableIDPointer(arena, layout.Align[index]),
+				})
+			}
+		}
+		encoded, err := json.Marshal(struct {
+			Candidate  int                   `json:"candidate"`
+			Vertical   VerticalDirection     `json:"vertical"`
+			Horizontal HorizontalDirection   `json:"horizontal"`
+			Nodes      []tracedCandidateNode `json:"nodes"`
+		}{candidateIndex, layout.VDirection, layout.HDirection, nodes})
+		if err != nil {
+			fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+			continue
+		}
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
+
+func traceNodePlacement(arena *layered.LGraphArena, graphID layered.LGraphID, stage string) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	nodes := make([]tracedNode, 0, len(arena.GraphAllNodes(graphID)))
+	for _, nodeID := range arena.GraphAllNodes(graphID) {
+		node := arena.Node(nodeID)
+		layer := -1
+		if node.Layer != nil {
+			layer = int(*node.Layer)
+		}
+		traced := tracedNode{
+			Index: int(nodeID), StableID: tracedNodeStableID(arena, nodeID), Layer: layer, Type: int(node.Type),
+			X: node.Position.X, Y: node.Position.Y,
+			Width: node.Size.X, Height: node.Size.Y,
+			MarginTop: node.Margin.Top, MarginBottom: node.Margin.Bottom,
+			Ports: make([]tracedPort, 0, len(node.Ports)),
+		}
+		for _, portID := range node.Ports {
+			port := arena.Port(portID)
+			traced.Ports = append(traced.Ports, tracedPort{
+				Index: int(portID), Side: int(port.Side), X: port.Position.X, Y: port.Position.Y,
+				AnchorX: port.Anchor.X, AnchorY: port.Anchor.Y,
+			})
+		}
+		nodes = append(nodes, traced)
+	}
+	encoded, err := json.Marshal(struct {
+		Stage string       `json:"stage"`
+		Nodes []tracedNode `json:"nodes"`
+	}{Stage: stage, Nodes: nodes})
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "elk trace encoding failed:", err)
+		return
+	}
+	fmt.Fprintln(os.Stderr, string(encoded))
+}
