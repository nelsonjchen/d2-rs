@@ -0,0 +1,39 @@
+// Copyright (c) 2026 Nelson Chen. Development diagnostics only.
+// SPDX-License-Identifier: MPL-2.0
+//go:build d2elkdiagnostic
+
+package p1cycles
+
+import (
+	"encoding/json"
+	basegraph "github.com/d2lang/elk-go/internal/graph"
+	"github.com/d2lang/elk-go/internal/layered"
+	"os"
+)
+
+func traceP1(arena *layered.LGraphArena, graph layered.LGraphID, operation string, chosen int, nodes []layered.LNodeID, indegree, outdegree, marks []int, sources, sinks []layered.LNodeID) {
+	if os.Getenv("D2_ELK_TRACE") == "" {
+		return
+	}
+	type Edge struct {
+		ID         layered.LEdgeID `json:"id"`
+		Source     layered.LNodeID `json:"source"`
+		Target     layered.LNodeID `json:"target"`
+		SourcePort layered.LPortID `json:"source_port"`
+		TargetPort layered.LPortID `json:"target_port"`
+		Reversed   bool            `json:"reversed"`
+	}
+	edges := []Edge{}
+	for _, node := range nodes {
+		for _, port := range arena.Node(node).Ports {
+			for _, edge := range arena.Port(port).OutgoingEdges {
+				e := arena.Edge(edge)
+				if e.Source == nil || e.Target == nil {
+					continue
+				}
+				edges = append(edges, Edge{edge, arena.EdgeSourceNode(edge), arena.EdgeTargetNode(edge), *e.Source, *e.Target, basegraph.Get(&e.Properties, layered.Reversed)})
+			}
+		}
+	}
+	_ = json.NewEncoder(os.Stderr).Encode(map[string]any{"stage": "p1-cycle", "graph": graph, "operation": operation, "chosen": chosen, "nodes": nodes, "indegree": indegree, "outdegree": outdegree, "marks": marks, "sources": sources, "sinks": sinks, "edges": edges})
+}
