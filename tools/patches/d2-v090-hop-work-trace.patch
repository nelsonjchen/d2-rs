+// TestClusterGapConnectedViewsFixture isolates the reduceGapToNeighbors call
+// made after a cluster-vessel move. It mirrors the retained-arena regression
+// and emits the exact source traversal identities under TALA_TRACE_GAP.
+func TestClusterGapConnectedViewsFixture(t *testing.T) {
+	ctx := withTestLogger(context.Background(), t)
+	first := layoutgraph.NewNode(1, 100, 80)
+	first.TopLeft = geo.NewPoint(0, 0)
+	second := layoutgraph.NewNode(2, 100, 80)
+	second.TopLeft = geo.NewPoint(0, 100)
+	nearest := layoutgraph.NewNode(3, 100, 80)
+	nearest.TopLeft = geo.NewPoint(400, 0)
+	tail := layoutgraph.NewNode(4, 100, 80)
+	tail.TopLeft = geo.NewPoint(600, 0)
+	graph := layoutgraph.NewGraph()
+	for _, node := range []*layoutgraph.Node{first, second, nearest, tail} {
+		graph.AddNewNodeToContainer(nil, node)
+	}
+	graph.Connect(first, nearest)
+	graph.Connect(second, nearest)
+	graph.Connect(nearest, tail)
+	vessel := layoutgraph.NewNode(5, 100, 180)
+	vessel.TopLeft = geo.NewPoint(0, 0)
+	cluster := &layoutgraph.Cluster{
+		Nodes:              []*layoutgraph.Node{first, second},
+		Graph:              graph,
+		Arrangement:        layoutgraph.Column,
+		DesiredArrangement: layoutgraph.Column,
+		Padding:            20,
+		Vessel:             vessel,
+	}
+	vessel.SetClusterVessel(true)
+	grouping.AddCluster(graph, cluster)
+	abductClusterEdgesForOptimizationFixture(cluster)
+	graph.CellSize = 20
+
+	moved, score, err := reduceGapToNeighbors(ctx, vessel, nil, gapReductionOptions{
+		axis:                   horizontalAxis,
+		direction:              forwardDirection,
+		attemptRecoverSymmetry: true,
+	})
+	assert.NoError(t, err)
+	assert.True(t, moved)
+	assert.Equal(t, uint64(0x408f404ec4ec4ec4), math.Float64bits(score))
+	assert.Equal(t, 250.0, nearest.TopLeft.X)
+	assert.Equal(t, 450.0, tail.TopLeft.X)
+	finalScore, err := placementcost.EdgeLength(ctx, graph, placementcost.EdgeLengthOptions{
+		IncludeNodeSizes:  true,
+		EnforceMinimumGap: false,
+		PenalizeDirection: false,
+	})
+	assert.NoError(t, err)
+	assert.Equal(t, uint64(0x408f404ec4ec4ec4), math.Float64bits(finalScore))
+}
