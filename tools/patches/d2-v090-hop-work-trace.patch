+package routing
+
+import (
+	"encoding/json"
+	"fmt"
+	"math"
+	"os"
+
+	"github.com/d2lang/d2/d2layouts/d2talalayout/internal/layoutgraph"
+	"github.com/d2lang/d2/lib/geo"
+)
+
+func traceReorderDuplicatesJSONL(event map[string]any) {
+	if os.Getenv("TALA_TRACE_REORDER_DUPLICATES_JSONL") == "" {
+		return
+	}
+	encoded, err := json.Marshal(event)
+	if err == nil {
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
+
+func traceReorderDuplicateOrder(edges, order []*layoutgraph.Edge) []int {
+	indices := make([]int, len(order))
+	for orderIndex, edge := range order {
+		for edgeIndex, candidate := range edges {
+			if edge == candidate {
+				indices[orderIndex] = edgeIndex
+				break
+			}
+		}
+	}
+	return indices
+}
+
+func traceReorderDuplicateRoute(points []*geo.Point) []map[string]string {
+	route := make([]map[string]string, len(points))
+	for index, point := range points {
+		route[index] = map[string]string{
+			"x_bits": fmt.Sprintf("0x%016x", math.Float64bits(point.X)),
+			"y_bits": fmt.Sprintf("0x%016x", math.Float64bits(point.Y)),
+		}
+	}
+	return route
+}
