+func tracePlacementCandidates(phase string, node *layoutgraph.Node, median *geo.Point, distance float64, minimizingSelf bool, points []geo.Point) {
+	if os.Getenv("TALA_TRACE_PLACEMENT") == "" || os.Getenv("TALA_TRACE_PLACEMENT_SNAPSHOTS_ONLY") != "" {
+		return
+	}
+	bits := func(v float64) string { return fmt.Sprintf("0x%016x", math.Float64bits(v)) }
+	point := func(p *geo.Point) map[string]string {
+		return map[string]string{"x_bits": bits(p.X), "y_bits": bits(p.Y)}
+	}
+	candidates := []map[string]string{}
+	for _, p := range points {
+		candidates = append(candidates, point(&p))
+	}
+	event := map[string]interface{}{"event": "placement-candidates", "phase": phase, "node": node.DebugID(), "median": point(median), "distance_bits": bits(distance), "minimizing_self": minimizingSelf, "points": candidates}
+	encoded, err := json.Marshal(event)
+	if err == nil {
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
+
+func tracePlacementScore(phase string, node *layoutgraph.Node, score, least float64) {
+	if os.Getenv("TALA_TRACE_PLACEMENT") == "" || os.Getenv("TALA_TRACE_PLACEMENT_SNAPSHOTS_ONLY") != "" {
