+	event := map[string]interface{}{"event": "placement-score", "phase": phase, "node": node.DebugID(), "x_bits": bits(node.TopLeft.X), "y_bits": bits(node.TopLeft.Y), "score_bits": bits(score), "least_bits": bits(least)}
+	encoded, err := json.Marshal(event)
+	if err == nil {
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
