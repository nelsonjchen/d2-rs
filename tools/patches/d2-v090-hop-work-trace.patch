+package trace
+
+import (
+	"encoding/json"
+	"fmt"
+	"math/rand"
+	"os"
+	"runtime"
+	"sync/atomic"
+)
+
+var nextNodePlacementStreamID atomic.Uint64
+
+type source struct {
+	rand.Source
+	stream   string
+	streamID uint64
+	draws    uint64
+}
+
+func (s *source) Int63() int64 {
+	value := s.Source.Int63()
+	s.draws++
+	streamID := parseTraceDrawCount(os.Getenv("TALA_TRACE_RNG_CALLSITE_STREAM_ID"))
+	streamIDMatches := os.Getenv("TALA_TRACE_RNG_CALLSITE_STREAM_ID") == "" || streamID == s.streamID
+	if s.stream == os.Getenv("TALA_TRACE_RNG_CALLSITE_STREAM") && streamIDMatches &&
+		s.draws == parseTraceDrawCount(os.Getenv("TALA_TRACE_RNG_CALLSITE_COUNT")) {
+		pcs := make([]uintptr, 16)
+		n := runtime.Callers(2, pcs)
+		frames := runtime.CallersFrames(pcs[:n])
+		fmt.Fprintf(os.Stderr, "TALA_RNG_CALLSITE stream=%s draw=%d\n", s.stream, s.draws)
+		for {
+			frame, more := frames.Next()
+			fmt.Fprintf(os.Stderr, "  %s %s:%d\n", frame.Function, frame.File, frame.Line)
+			if !more {
+				break
+			}
+		}
+	}
+	if os.Getenv("TALA_TRACE_RNG_JSONL") != "" {
+		traceEvent := map[string]any{
+			"event": "rng", "stream": s.stream, "operation": "int63",
+			"result": fmt.Sprintf("%d", value), "draw_count": s.draws,
+		}
+		if s.stream == "node-placement" {
+			traceEvent["stream_id"] = s.streamID
+		}
+		encoded, err := json.Marshal(traceEvent)
+		if err == nil {
+			fmt.Fprintln(os.Stderr, string(encoded))
+		}
+	}
+	return value
+}
+
+func parseTraceDrawCount(value string) uint64 {
+	var count uint64
+	if value == "" {
+		return 0
+	}
+	_, _ = fmt.Sscan(value, &count)
+	return count
+}
+
+func NewRand(seed int64, stream string) *rand.Rand {
+	streamID := uint64(0)
+	if stream == "node-placement" {
+		streamID = nextNodePlacementStreamID.Add(1)
+	}
+	if os.Getenv("TALA_TRACE_RNG_JSONL") != "" {
+		event := map[string]any{"event": "rng-init", "stream": stream, "seed": seed}
+		if stream == "node-placement" {
+			event["stream_id"] = streamID
+		}
+		if encoded, err := json.Marshal(event); err == nil {
+			fmt.Fprintln(os.Stderr, string(encoded))
+		}
+	}
+	return rand.New(&source{Source: rand.NewSource(seed), stream: stream, streamID: streamID})
+}
