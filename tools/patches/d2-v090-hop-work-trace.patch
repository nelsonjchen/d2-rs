+func tracePlacementGraphNodeIDs(g *layoutgraph.Graph) []string {
+	if g == nil {
+		return nil
+	}
+	ids := make([]string, 0, len(g.Nodes))
+	for _, node := range g.Nodes {
+		ids = append(ids, node.DebugID())
+	}
+	return ids
