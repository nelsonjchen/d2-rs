+// traceOptimizerCandidateOccupancy is a temporary diagnostic for comparing
+// one sized-candidate legality decision with the Rust implementation.
+func traceOptimizerCandidateOccupancy(node *layoutgraph.Node, point *geo.Point, occupied bool) {
+	if node == nil || node.Graph == nil || point == nil || os.Getenv("TALA_TRACE_SIZED_OCCUPANCY") == "" || !traceSizedGraphScope(node.Graph) {
+		return
+	}
+	if os.Getenv("TALA_TRACE_SIZED_PASS") != "" && !layoutgraph.SizedPassTraceActive(node.Graph) {
+		return
+	}
+	if target := os.Getenv("TALA_TRACE_SIZED_OCCUPANCY_NODE"); target != "" && target != "all" && target != fmt.Sprint(node.ID) && target != node.DebugID() {
+		return
+	}
+	if target := os.Getenv("TALA_TRACE_SIZED_OCCUPANCY_POINT"); target != "" && target != fmt.Sprintf("%g,%g", point.X, point.Y) {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "SIZED_OCCUPANCY_GO node=%d point=%g,%g occupied=%t graph_nodes=%d\n", node.ID, point.X, point.Y, occupied, len(node.Graph.Nodes))
+	right := point.X + node.Width
+	bottom := point.Y + node.Height
+	for graphIndex, other := range node.Graph.Nodes {
+		if other == nil || other == node || other.TopLeft == nil {
+			continue
+		}
+		const maxSafeDelta = 500.0
+		if point.X > other.TopLeft.X+other.Width+maxSafeDelta ||
+			point.X+node.Width+maxSafeDelta < other.TopLeft.X ||
+			point.Y > other.TopLeft.Y+other.Height+maxSafeDelta ||
+			point.Y+node.Height+maxSafeDelta < other.TopLeft.Y {
+			continue
+		}
+		delta := float64(node.DeltaTo(other, point))
+		overlaps := point.X < other.TopLeft.X+other.Width+delta && right+delta > other.TopLeft.X &&
+			point.Y < other.TopLeft.Y+other.Height+delta && bottom+delta > other.TopLeft.Y
+		if overlaps {
+			fmt.Fprintf(os.Stderr, "SIZED_OCCUPANCY_BLOCKER_GO graph_index=%d other=%d debug=%s at=%g,%g size=%g,%g delta=%g\n", graphIndex, other.ID, other.DebugID(), other.TopLeft.X, other.TopLeft.Y, other.Width, other.Height, delta)
+		}
+	}
+}
