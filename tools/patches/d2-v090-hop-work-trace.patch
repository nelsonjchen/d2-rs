+func tracePlacementEdgeTopology(phase string, graph *layoutgraph.Graph, edgeAbductions []*layoutgraph.EdgeAbduction) {
+	target, err := strconv.ParseInt(os.Getenv("TALA_TRACE_SCOPE_EDGE_NODE"), 10, 64)
+	if err != nil || graph == nil {
+		return
+	}
+	found := false
+	for _, node := range graph.Nodes {
+		if node != nil && node.ID == target {
+			found = true
+			break
+		}
+	}
+	if !found {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "PLACEMENT_EDGE_TOPOLOGY_GO phase=%s target=%d nodes=%d edges=%d abductions=%d", phase, target, len(graph.Nodes), len(graph.Edges), len(edgeAbductions))
+	for _, edge := range graph.Edges {
+		if edge == nil || (edge.From.ID != target && edge.To.ID != target) {
+			continue
+		}
+		fmt.Fprintf(os.Stderr, " edge=%d:%d>%d", edge.ID, edge.From.ID, edge.To.ID)
+	}
+	for i, abduction := range edgeAbductions {
+		if abduction == nil || (abduction.CurrentFrom != nil && abduction.CurrentFrom.ID != target && abduction.CurrentTo != nil && abduction.CurrentTo.ID != target) {
+			continue
+		}
+		fromID, toID, originalFromID, originalToID := int64(-1), int64(-1), int64(-1), int64(-1)
+		if abduction.CurrentFrom != nil {
+			fromID = abduction.CurrentFrom.ID
+		}
+		if abduction.CurrentTo != nil {
+			toID = abduction.CurrentTo.ID
+		}
+		if abduction.OriginallyFrom != nil {
+			originalFromID = abduction.OriginallyFrom.ID
+		}
+		if abduction.OriginallyTo != nil {
+			originalToID = abduction.OriginallyTo.ID
+		}
+		fmt.Fprintf(os.Stderr, " abduction=%d:%d>%d(orig=%d>%d)", i, fromID, toID, originalFromID, originalToID)
+	}
+	fmt.Fprintln(os.Stderr)
+}
