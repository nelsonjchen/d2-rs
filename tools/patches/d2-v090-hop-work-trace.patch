+func traceDagreObjects(phase string, g *d2graph.Graph) {
+	if os.Getenv("DAGRE_TRACE_OBJECTS") == "" {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "GO_PHASE %s\n", phase)
+	for _, obj := range g.Objects {
+		parent := "<root>"
+		if obj.Parent != nil {
+			parent = obj.Parent.AbsID()
+		}
+		if obj.Box == nil || obj.TopLeft == nil {
+			fmt.Fprintf(os.Stderr, "GO_OBJ %q <no-box> parent=%q\n", obj.AbsID(), parent)
+			continue
+		}
+		fmt.Fprintf(os.Stderr, "GO_OBJ %q %.17g %.17g %.17g %.17g parent=%q bits=%016x,%016x,%016x,%016x\n", obj.AbsID(), obj.TopLeft.X, obj.TopLeft.Y, obj.Width, obj.Height, parent, math.Float64bits(obj.TopLeft.X), math.Float64bits(obj.TopLeft.Y), math.Float64bits(obj.Width), math.Float64bits(obj.Height))
+	}
+	fmt.Fprintf(os.Stderr, "GO_EDGESET count=%d\n", len(g.Edges))
+	type edgePair struct{ src, dst string }
+	ordinals := make(map[edgePair]int)
+	for _, edge := range g.Edges {
+		pair := edgePair{src: edge.Src.AbsID(), dst: edge.Dst.AbsID()}
+		identity := fmt.Sprintf("%d:%s -> %d:%s #%d", len(pair.src), pair.src, len(pair.dst), pair.dst, ordinals[pair])
+		ordinals[pair]++
+		quotedIdentity, _ := json.Marshal(identity)
+		pointBits := make([]string, len(edge.Route))
+		for i, point := range edge.Route {
+			pointBits[i] = fmt.Sprintf("%016x,%016x", math.Float64bits(point.X), math.Float64bits(point.Y))
+		}
+		fmt.Fprintf(os.Stderr, "GO_EDGE %s point_count=%d bits=%s\n", quotedIdentity, len(edge.Route), strings.Join(pointBits, ";"))
+	}
+}
+
+func debugRoute(points []*geo.Point) []string {
+	out := make([]string, len(points))
+	for i, point := range points {
+		out[i] = fmt.Sprintf("(%.17g,%.17g)", point.X, point.Y)
+	}
+	return out
+}
