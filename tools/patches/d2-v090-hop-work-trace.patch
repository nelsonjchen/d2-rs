@@ -0,0 +1,48 @@
+package routing
+
+import (
+	"context"
+	"math"
+	"testing"
+
+	"github.com/d2lang/d2/lib/geo"
+)
+
+func TestCodexBalanceGo127FloatSemantics(t *testing.T) {
+	t.Run("indexed spacing arithmetic", func(t *testing.T) {
+		values, err := evenlyDistributeGuarded(0, 56763892615818120, 6, &routeWorkGuard{
+			ctx: context.Background(), limit: 100,
+		})
+		if err != nil {
+			t.Fatal(err)
+		}
+		if got := math.Float64bits(values[5]); got != 0x43659b6808cbe93c {
+			t.Fatalf("last distributed lane bits = %016x, want %016x", got, uint64(0x43659b6808cbe93c))
+		}
+	})
+
+	t.Run("rounded signed zero map keys", func(t *testing.T) {
+		lanes := map[float64]struct{}{
+			math.Round(-0.4): {},
+			math.Round(0.4):  {},
+		}
+		if len(lanes) != 1 {
+			t.Fatalf("rounded zero lane count = %d, want 1", len(lanes))
+		}
+	})
+
+	t.Run("collapsed route keeps two points", func(t *testing.T) {
+		guard, err := newRouteWorkGuard(context.Background(), "duplicate-point fixture", 100)
+		if err != nil {
+			t.Fatal(err)
+		}
+		point := &geo.Point{X: 12, Y: -4}
+		points, err := removeDuplicatePointsGuarded([]*geo.Point{point, point.Copy()}, guard)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if len(points) != 2 || points[0].X != 12 || points[0].Y != -4 || points[1].X != 13 || points[1].Y != -4 {
+			t.Fatalf("collapsed route = %#v, want [(12,-4),(13,-4)]", points)
+		}
+	})
+}
