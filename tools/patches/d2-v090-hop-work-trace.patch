+// tracePlacementGraphOwners records the concrete Graph.Nodes slices reached
+// through Node.Graph at a trace boundary. The regular placement event walks
+// Containers recursively, so it cannot distinguish a child owned by a
+// different graph from a node in the callback graph's live Nodes slice.
+func tracePlacementGraphOwners(phase string, g *layoutgraph.Graph, root *layoutgraph.Node) {
+	rootID := "top"
+	var rootGraph *layoutgraph.Graph
+	if root != nil {
+		rootID = root.DebugID()
+		rootGraph = root.Graph
+	}
+	visited := map[*layoutgraph.Node]bool{}
+	nodes := make([]map[string]interface{}, 0)
+	var visit func(*layoutgraph.Graph, *layoutgraph.Node)
+	visit = func(owner *layoutgraph.Graph, node *layoutgraph.Node) {
+		if node == nil || visited[node] {
+			return
+		}
+		visited[node] = true
+		var actualOwner *layoutgraph.Graph
+		if node.Graph != nil {
+			actualOwner = node.Graph
+		}
+		containerChildren := make([]string, 0, len(owner.Containers[node]))
+		for _, child := range owner.Containers[node] {
+			containerChildren = append(containerChildren, child.DebugID())
+		}
+		ownerRecord := map[string]interface{}{
+			"id": node.DebugID(), "owner_graph_nodes": tracePlacementGraphNodeIDs(actualOwner),
+			"container_children": containerChildren,
+		}
+		if os.Getenv("TALA_TRACE_GRAPH_OWNER_TARGET") == node.DebugID() {
+			ownerRecord["top_left"] = node.TopLeft
+			ownerRecord["width"] = node.Width
+			ownerRecord["height"] = node.Height
+		}
+		nodes = append(nodes, ownerRecord)
+		for _, child := range owner.Containers[node] {
+			visit(owner, child)
+		}
+	}
+	for _, node := range g.Nodes {
+		visit(g, node)
+	}
+	if rootGraph != nil && rootGraph != g {
+		for _, node := range rootGraph.Nodes {
+			visit(rootGraph, node)
+		}
+	}
+	encoded, err := json.Marshal(map[string]interface{}{
+		"event": "placement-owner", "phase": phase, "root": rootID,
+		"callback_graph_nodes": tracePlacementGraphNodeIDs(g),
+		"root_graph_nodes":     tracePlacementGraphNodeIDs(rootGraph),
+		"node_owners":          nodes,
+	})
+	if err == nil {
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
+
+func tracePlacement(phase string, g *layoutgraph.Graph, root *layoutgraph.Node) {
+	tracePlacementWithCellSize(phase, g, root, g.CellSize)
+}
+
+// tracePlacementWithCellSize snapshots owner-visible node geometry while
+// recording the cell lattice of the subgraph currently being optimized.
+// placeNodesOrthogonally receives a subgraph with its computed CellSize, but
+// root.Graph can still point at an owning graph whose CellSize is zero.
+func tracePlacementWithCellSize(phase string, g *layoutgraph.Graph, root *layoutgraph.Node, cellSize float64) {
+	if os.Getenv("TALA_TRACE_GRAPH_OWNERS") != "" {
+		tracePlacementGraphOwners(phase, g, root)
+	}
+	if os.Getenv("TALA_TRACE_PLACEMENT") == "" {
+		return
+	}
+	bits := func(v float64) string { return fmt.Sprintf("0x%016x", math.Float64bits(v)) }
+	nodes := []map[string]interface{}{}
+	seen := map[*layoutgraph.Node]bool{}
+	var visit func(*layoutgraph.Node)
+	visit = func(n *layoutgraph.Node) {
+		if n == nil || seen[n] {
+			return
+		}
+		seen[n] = true
+		item := map[string]interface{}{"id": n.DebugID(), "stable_id": fmt.Sprintf("%d", n.ID), "w_bits": bits(n.Width), "h_bits": bits(n.Height)}
+		if n.TopLeft != nil {
+			item["x_bits"] = bits(n.TopLeft.X)
+			item["y_bits"] = bits(n.TopLeft.Y)
+		}
+		if n.FixedTopLeft != nil {
+			item["fixed_x_bits"] = bits(n.FixedTopLeft.X)
+			item["fixed_y_bits"] = bits(n.FixedTopLeft.Y)
+		}
+		nodes = append(nodes, item)
+		for _, child := range g.Containers[n] {
+			visit(child)
+		}
+	}
+	for _, n := range g.Nodes {
+		visit(n)
+	}
+	rootID := ""
+	if root != nil {
+		rootID = root.DebugID()
+	} else {
+		rootID = "top"
+	}
+	if target := os.Getenv("TALA_TRACE_PLACEMENT_ROOT"); target != "" && target != rootID {
+		return
+	}
+	event := map[string]interface{}{"event": "placement", "phase": phase, "root": rootID, "cell_bits": bits(cellSize), "nodes": nodes}
+	encoded, err := json.Marshal(event)
+	if err == nil {
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
