+package geo
+
+import (
+	"math"
+	"testing"
+)
+
+func TestCodexEuclideanDistanceAxisExtremeValues(t *testing.T) {
+	tests := []struct {
+		name string
+		from Point
+		to   Point
+		want uint64
+	}{
+		{
+			name: "large horizontal delta does not overflow while squaring",
+			from: Point{X: 0, Y: 7},
+			to:   Point{X: 1e200, Y: 7},
+			want: 0x6974e718d7d7625a,
+		},
+		{
+			name: "small vertical delta does not underflow while squaring",
+			from: Point{X: 4, Y: 0},
+			to:   Point{X: 4, Y: 1e-200},
+			want: 0x16687e92154ef7ac,
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got := EuclideanDistance(test.from.X, test.from.Y, test.to.X, test.to.Y)
+			if bits := math.Float64bits(got); bits != test.want {
+				t.Fatalf("distance bits = %016x, want %016x (value %.17g)", bits, test.want, got)
+			}
+		})
+	}
+}
