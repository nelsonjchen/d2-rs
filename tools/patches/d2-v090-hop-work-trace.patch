new file mode 100644
index 000000000..bccb03269
--- /dev/null
+++ b/d2layouts/d2talalayout/internal/routing/codex_tunnel_cut_trace_test.go
@@ -0,0 +1,155 @@
+package routing
+
+import (
+	"context"
+	"errors"
+	"testing"
+
+	"github.com/d2lang/d2/d2layouts/d2talalayout/internal/layoutgraph"
+	"github.com/d2lang/d2/lib/geo"
+)
+
+// TestReferenceStraightLineTunnelCutBoundaries is a diagnostic oracle fixture
+// for d2-rs. Run it with TALA_TRACE_SWAP_PORTS_JSONL=1 to capture the same
+// ordered range and candidate events as the Rust regression.
+func TestReferenceStraightLineTunnelCutBoundaries(t *testing.T) {
+	type scenario struct {
+		name                          string
+		obstacleX, obstacleY          float64
+		obstacleWidth, obstacleHeight float64
+		threshold                     uint64
+		wantChanged                   bool
+		wantRoute                     []*geo.Point
+	}
+	original := []*geo.Point{
+		geo.NewPoint(200, 110), geo.NewPoint(220, 110),
+		geo.NewPoint(220, 140), geo.NewPoint(250, 140),
+	}
+	cases := []scenario{
+		{name: "clip-start", obstacleX: 210, obstacleY: 100, obstacleWidth: 20, obstacleHeight: 30,
+			threshold: 17, wantChanged: true, wantRoute: []*geo.Point{geo.NewPoint(200, 135), geo.NewPoint(250, 135)}},
+		{name: "clip-end", obstacleX: 210, obstacleY: 145, obstacleWidth: 20, obstacleHeight: 30,
+			threshold: 17, wantChanged: true, wantRoute: []*geo.Point{geo.NewPoint(200, 125), geo.NewPoint(250, 125)}},
+		{name: "disjoint-cut-preserves-range", obstacleX: 210, obstacleY: 200, obstacleWidth: 20, obstacleHeight: 20,
+			threshold: 17, wantChanged: true, wantRoute: []*geo.Point{geo.NewPoint(200, 125), geo.NewPoint(250, 125)}},
+		{name: "cut-deletes-entire-range", obstacleX: 190, obstacleY: 100, obstacleWidth: 100, obstacleHeight: 60,
+			threshold: 14, wantChanged: false, wantRoute: original},
+	}
+	makeGraph := func(tc scenario) (*layoutgraph.Graph, *layoutgraph.Edge) {
+		g := layoutgraph.NewGraph()
+		from := g.AddNode(layoutgraph.NewNode(1, 100, 60))
+		to := g.AddNode(layoutgraph.NewNode(2, 50, 60))
+		obstacle := g.AddNode(layoutgraph.NewNode(3, tc.obstacleWidth, tc.obstacleHeight))
+		from.TopLeft = geo.NewPoint(100, 100)
+		to.TopLeft = geo.NewPoint(250, 120)
+		obstacle.TopLeft = geo.NewPoint(tc.obstacleX, tc.obstacleY)
+		edge := g.Connect(from, to)
+		edge.Points = make([]*geo.Point, len(original))
+		for index, point := range original {
+			edge.Points[index] = point.Copy()
+		}
+		return g, edge
+	}
+	for _, tc := range cases {
+		for _, limit := range []uint64{tc.threshold - 1, tc.threshold} {
+			g, edge := makeGraph(tc)
+			guard, err := newRouteWorkGuard(context.Background(), "reference tunnel cut trace", limit)
+			if err != nil {
+				t.Fatal(err)
+			}
+			changed, err := refineEdgeGuarded(g, edge, guard)
+			if limit < tc.threshold {
+				if !errors.Is(err, errRouteStageWorkLimit) {
+					t.Fatalf("%s at limit %d: got %v, want route work limit", tc.name, limit, err)
+				}
+				if changed || !sameRoute(edge.Points, original) {
+					t.Fatalf("%s mutated below its threshold: changed=%t route=%v", tc.name, changed, edge.Points)
+				}
+				continue
+			}
+			if err != nil {
+				t.Fatalf("%s at exact limit %d: %v", tc.name, limit, err)
+			}
+			if changed != tc.wantChanged || !sameRoute(edge.Points, tc.wantRoute) {
+				t.Fatalf("%s: changed=%t route=%v, want changed=%t route=%v", tc.name, changed, edge.Points, tc.wantChanged, tc.wantRoute)
+			}
+		}
+	}
+}
+
+// TestReferenceStraightLineScansMultipleSplitRanges is the Go 1.27.0 oracle
+// for Rust's checked_straight_line_scans_multiple_split_ranges_in_go_order.
+func TestReferenceStraightLineScansMultipleSplitRanges(t *testing.T) {
+	original := []*geo.Point{
+		geo.NewPoint(200, 110), geo.NewPoint(220, 110),
+		geo.NewPoint(220, 140), geo.NewPoint(250, 140),
+	}
+	for _, limit := range []uint64{63, 64} {
+		g, edge := makeReferenceMultipleSplitRangeGraph(t, original)
+		guard, err := newRouteWorkGuard(context.Background(), "multiple split tunnel ranges", limit)
+		if err != nil {
+			t.Fatal(err)
+		}
+		changed, err := refineEdgeGuarded(g, edge, guard)
+		if limit == 63 {
+			if !errors.Is(err, errRouteStageWorkLimit) {
+				t.Fatalf("limit %d: got %v, want route work limit", limit, err)
+			}
+			if changed || !sameRoute(edge.Points, original) {
+				t.Fatalf("limit %d mutated the route: changed=%t route=%v", limit, changed, edge.Points)
+			}
+			continue
+		}
+		if err != nil {
+			t.Fatalf("exact limit %d: %v", limit, err)
+		}
+		if changed || !sameRoute(edge.Points, original) {
+			t.Fatalf("exact limit %d: changed=%t route=%v, want unchanged", limit, changed, edge.Points)
+		}
+	}
+}
+
+func makeReferenceMultipleSplitRangeGraph(t *testing.T, original []*geo.Point) (*layoutgraph.Graph, *layoutgraph.Edge) {
+	t.Helper()
+	g := layoutgraph.NewGraph()
+	from := g.AddNode(layoutgraph.NewNode(0, 100, 80))
+	to := g.AddNode(layoutgraph.NewNode(1, 50, 80))
+	firstObstacle := g.AddNode(layoutgraph.NewNode(2, 20, 10))
+	secondObstacle := g.AddNode(layoutgraph.NewNode(3, 20, 10))
+	remotes := make([]*layoutgraph.Node, 5)
+	for index := range remotes {
+		remotes[index] = g.AddNode(layoutgraph.NewNode(layoutgraph.EntityID(index+4), 20, 20))
+	}
+	from.TopLeft = geo.NewPoint(100, 100)
+	to.TopLeft = geo.NewPoint(250, 120)
+	firstObstacle.TopLeft = geo.NewPoint(210, 135)
+	secondObstacle.TopLeft = geo.NewPoint(210, 155)
+	for index, remote := range remotes {
+		remote.TopLeft = geo.NewPoint(0, float64(500+index*100))
+	}
+	edge := g.Connect(from, to)
+	edge.Points = make([]*geo.Point, len(original))
+	for index, point := range original {
+		edge.Points[index] = point.Copy()
+	}
+	for index, remote := range remotes {
+		blocker := g.Connect(from, remote)
+		blocker.Points = []*geo.Point{
+			geo.NewPoint(200, []float64{125, 130, 150, 170, 175}[index]),
+			geo.NewPoint(0, float64(500+index*100)),
+		}
+	}
+	return g, edge
+}
+
+func sameRoute(got, want []*geo.Point) bool {
+	if len(got) != len(want) {
+		return false
+	}
+	for index := range got {
+		if !got[index].Equals(want[index]) {
+			return false
+		}
+	}
+	return true
+}
