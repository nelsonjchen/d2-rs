+func TestCodexHasOverlappingEndUsesSharedRoutePoints(t *testing.T) {
+	graph := layoutgraph.NewGraph()
+	source := layoutgraph.NewNode(1, 20, 20)
+	target := layoutgraph.NewNode(2, 20, 20)
+	otherTarget := layoutgraph.NewNode(3, 20, 20)
+	source.TopLeft = geo.NewPoint(0, 0)
+	target.TopLeft = geo.NewPoint(100, 100)
+	otherTarget.TopLeft = geo.NewPoint(200, 200)
+	for _, node := range []*layoutgraph.Node{source, target, otherTarget} {
+		graph.AddNewNodeToContainer(nil, node)
+	}
+	edge := graph.Connect(source, target)
+	other := graph.Connect(source, otherTarget)
+	edge.Points = []*geo.Point{geo.NewPoint(1, 0), geo.NewPoint(100, 100)}
+	other.Points = []*geo.Point{geo.NewPoint(1, 0), geo.NewPoint(200, 200)}
+	if !edge.HasOverlappingEnd() {
