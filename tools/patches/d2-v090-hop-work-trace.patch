--- /dev/null
+++ b/d2layouts/d2talalayout/internal/placement/abduction_median_probe_test.go
@@ -0,0 +1,53 @@
+package placement
+
+import (
+	"context"
+	"testing"
+
+	"github.com/d2lang/d2/d2layouts/d2talalayout/internal/layoutgraph"
+	"github.com/d2lang/d2/d2layouts/d2talalayout/internal/limits"
+	"github.com/d2lang/d2/lib/geo"
+)
+
+func TestAbductedMedianUsesOriginalEndpointPointer(t *testing.T) {
+	const cellSize = 269.0
+	scope := layoutgraph.NewGraph()
+	scope.CellSize = cellSize
+	makeNode := func(g *layoutgraph.Graph, id layoutgraph.EntityID, x, y, width, height float64) *layoutgraph.Node {
+		node := layoutgraph.NewNode(id, width, height)
+		node.TopLeft = geo.NewPoint(x, y)
+		g.AddNodeUnchecked(node)
+		return node
+	}
+	tower := makeNode(scope, 1, -269, 0, 293, 616)
+	processor := makeNode(scope, 2, 1076, 0, 231, 248)
+	edge := scope.Connect(tower, processor)
+
+	outer := layoutgraph.NewGraph()
+	outer.CellSize = cellSize
+	originalEndpoint := makeNode(outer, 4, -209, 396, 160, 160)
+	outer.AddNodeToContainer(tower, originalEndpoint)
+	abductions := []*layoutgraph.EdgeAbduction{{
+		Edge: edge, OriginallyFrom: originalEndpoint,
+		CurrentFrom: tower, CurrentTo: processor,
+	}}
+	guard, err := limits.NewOptimizationWorkGuard(context.Background(), "LocalOptimize", limits.MaxOptimizationWorkUnits)
+	if err != nil {
+		t.Fatal(err)
+	}
+	adjacents, err := optimizerAdjacents(processor, abductions, guard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(adjacents) != 1 || adjacents[0] != originalEndpoint {
+		t.Fatalf("optimizerAdjacents() = %v, want the original endpoint pointer", adjacents)
+	}
+	x, y, err := optimizerMedianToNeighbors(processor, true, abductions, guard)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if wantX, wantY := -129.0/cellSize, 476.0/cellSize; x != wantX || y != wantY {
+		t.Fatalf("Go optimizer median = %.17g, %.17g; want %.17g, %.17g", x, y, wantX, wantY)
+	}
