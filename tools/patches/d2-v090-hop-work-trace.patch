+// Development observer of the actual graph-owned route points at each stage.
+func traceStandaloneStage(g *layoutgraph.Graph, stage string) {
+ if os.Getenv("D2_TRACE_ROUTER_STAGE") != "1" { return }
+ fmt.Fprintf(os.Stderr, "ROUTER_STAGE begin stage=%s\n", stage)
+ for _, edge := range g.Edges {
+  points := make([]string, 0, len(edge.Points))
+  for _, p := range edge.Points { points = append(points, fmt.Sprintf("%016x,%016x", math.Float64bits(p.X), math.Float64bits(p.Y))) }
+  fmt.Fprintf(os.Stderr, "ROUTER_STAGE edge=%d points=%s\n", edge.ID, strings.Join(points, ";"))
+ }
+ fmt.Fprintln(os.Stderr, "ROUTER_STAGE end")
+}
