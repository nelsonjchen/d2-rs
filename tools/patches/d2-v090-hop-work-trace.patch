+// traceSizedGraphScope is deliberately diagnostic-only.  A layout run can
+// contain many placement graphs with the same node count, so a node-count
+// filter is not enough to correlate Go and Rust traces.  The caller supplies
+// the complete stable TALA ID set for the graph under investigation.
+func traceSizedGraphScope(g *layoutgraph.Graph) bool {
+	ids := os.Getenv("TALA_TRACE_SIZED_GRAPH_IDS")
+	if ids == "" {
+		return false
+	}
+	if ids == "all" {
+		return true
+	}
+	if rawID, ok := strings.CutPrefix(ids, "contains:"); ok {
+		target, err := strconv.ParseInt(strings.TrimSpace(rawID), 10, 64)
+		if err != nil {
+			return false
+		}
+		for _, node := range g.Nodes {
+			if node == nil {
+				continue
+			}
+			if node.ID == target {
+				return true
+			}
+			if debugID, err := strconv.ParseInt(node.DebugID(), 10, 64); err == nil && debugID == target {
+				return true
+			}
+		}
+		return false
+	}
+	wanted := make(map[int64]struct{})
+	for _, raw := range strings.Split(ids, ",") {
+		id, err := strconv.ParseInt(strings.TrimSpace(raw), 10, 64)
+		if err != nil {
+			return false
+		}
+		wanted[id] = struct{}{}
+	}
+	if len(wanted) != len(g.Nodes) {
+		return false
+	}
+	for _, node := range g.Nodes {
+		if node == nil {
+			return false
+		}
+		if _, ok := wanted[node.ID]; ok {
+			continue
+		}
+		debugID, err := strconv.ParseInt(node.DebugID(), 10, 64)
+		if err != nil {
+			return false
+		}
+		if _, ok := wanted[debugID]; !ok {
+			return false
+		}
+	}
+	return true
+}
+
+func traceSizedGraphState(label string, g *layoutgraph.Graph) {
+	if !traceSizedGraphScope(g) || os.Getenv("TALA_TRACE_SIZED_GRAPH_STATE") == "" {
+		return
+	}
+	fmt.Fprintf(os.Stderr, "SIZED_GRAPH_STATE_GO %s", label)
+	for _, node := range g.Nodes {
+		if node.TopLeft == nil {
+			fmt.Fprintf(os.Stderr, " %d@nil", node.ID)
+			continue
+		}
+		fmt.Fprintf(os.Stderr, " %d@%g,%g", node.ID, node.TopLeft.X, node.TopLeft.Y)
+	}
+	fmt.Fprintln(os.Stderr)
+}
+
+func traceSizedExternalPositions(g *layoutgraph.Graph) map[string]map[string]string {
+	positions := make(map[string]map[string]string)
+	if g == nil {
+		return positions
+	}
+	wanted := make(map[int64]struct{})
+	for _, raw := range strings.Split(os.Getenv("TALA_TRACE_SIZED_EXTERNAL_IDS"), ",") {
+		id, err := strconv.ParseInt(strings.TrimSpace(raw), 10, 64)
+		if err == nil {
+			wanted[id] = struct{}{}
+		}
+	}
+	if len(wanted) == 0 {
+		return positions
+	}
+	for node := range g.Containers {
+		if node == nil || node.TopLeft == nil {
+			continue
+		}
+		if _, ok := wanted[node.ID]; !ok {
+			continue
+		}
+		positions[strconv.FormatInt(node.ID, 10)] = map[string]string{
+			"x_bits": fmt.Sprintf("%016x", math.Float64bits(node.TopLeft.X)),
+			"y_bits": fmt.Sprintf("%016x", math.Float64bits(node.TopLeft.Y)),
+		}
+	}
+	return positions
