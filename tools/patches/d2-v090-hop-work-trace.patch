+func traceGridState(g *d2graph.Graph, obj *d2graph.Object) {
+	scope := strings.TrimPrefix(obj.AbsID(), "b.")
+	if scope == "" {
+		scope = "root"
+	}
+	scopeHex := hex.EncodeToString([]byte(scope))
+	var records []string
+	objects := append([]*d2graph.Object(nil), g.Objects...)
+	sort.Slice(objects, func(i, j int) bool { return objects[i].AbsID() < objects[j].AbsID() })
+	for _, object := range objects {
+		nodeID := hex.EncodeToString([]byte(strings.TrimPrefix(object.AbsID(), "b.")))
+		records = append(records, fmt.Sprintf(
+			"GRID_STATE stage=grid scope=%s node=%s rect=%016x,%016x,%016x,%016x",
+			scopeHex,
+			nodeID,
+			math.Float64bits(object.TopLeft.X),
+			math.Float64bits(object.TopLeft.Y),
+			math.Float64bits(object.Width),
+			math.Float64bits(object.Height),
+		))
+		if object.LabelPosition != nil {
+			records = append(records, fmt.Sprintf(
+				"GRID_LABEL stage=grid scope=%s node=%s position=%s",
+				scopeHex, nodeID, *object.LabelPosition,
+			))
+		}
+	}
+	ordinals := make(map[string]int)
+	for _, edge := range g.Edges {
+		source := hex.EncodeToString([]byte(strings.TrimPrefix(edge.Src.AbsID(), "b.")))
+		target := hex.EncodeToString([]byte(strings.TrimPrefix(edge.Dst.AbsID(), "b.")))
+		pair := source + ">" + target
+		ordinal := ordinals[pair]
+		ordinals[pair] = ordinal + 1
+		if len(edge.Route) == 0 {
+			continue
+		}
+		points := make([]string, 0, len(edge.Route))
+		for _, point := range edge.Route {
+			points = append(points, fmt.Sprintf("%016x,%016x", math.Float64bits(point.X), math.Float64bits(point.Y)))
+		}
+		records = append(records, fmt.Sprintf(
+			"GRID_ROUTE stage=grid scope=%s edge=%s>%s#%d points=%s",
+			scopeHex, source, target, ordinal, strings.Join(points, ";"),
+		))
+	}
+	sort.Strings(records)
+	for _, record := range records {
+		fmt.Fprintln(os.Stderr, record)
+	}
+}
