+// Diagnostic-only work checkpoints. Filters contain float bits, preserving the
+// exact coordinates of ordinary and coincident port nodes without rounding.
+func (router *ovgEdgeRouter) traceHopWork(edge *layoutgraph.Edge, from, to *OVGNode, horizontal bool, phase string) {
+	if os.Getenv("D2_TRACE_HOP_WORK") != "1" { return }
+	if flavor := os.Getenv("D2_TRACE_SEARCH_FLAVOR"); flavor != "" && flavor != string(router.flavor) { return }
+	if wanted := os.Getenv("D2_TRACE_SEARCH_EDGE"); wanted != "" && wanted != fmt.Sprint(edge.ID) { return }
+	bits := func(value float64) string { return fmt.Sprintf("0x%016x", math.Float64bits(value)) }
+	for _, filter := range []struct { name, actual string }{
+		{"D2_TRACE_HOP_FROM_X_BITS", bits(from.X)}, {"D2_TRACE_HOP_FROM_Y_BITS", bits(from.Y)},
+	} { if wanted := os.Getenv(filter.name); wanted != "" && wanted != filter.actual { return } }
+	row := map[string]any{"event":"route-search-hop-work", "edge":edge.ID, "flavor":router.flavor,
+		"phase":phase, "work":router.work.used, "horizontal":horizontal,
+		"from_x_bits":bits(from.X), "from_y_bits":bits(from.Y),
+		"scope_nodes":len(router.graph.Nodes), "scope_edges":len(router.graph.Edges)}
+	if to != nil {
+		for _, filter := range []struct { name, actual string }{
+			{"D2_TRACE_HOP_TO_X_BITS", bits(to.X)}, {"D2_TRACE_HOP_TO_Y_BITS", bits(to.Y)},
+		} { if wanted := os.Getenv(filter.name); wanted != "" && wanted != filter.actual { return } }
+		row["to_x_bits"], row["to_y_bits"] = bits(to.X), bits(to.Y)
+	}
+	data, err := json.Marshal(row)
+	if err == nil { fmt.Fprintln(os.Stderr, string(data)) }
+}
