+// Development-only diagnostics for the optional source-container transform.
+// The pristine release has no trace hook; this exists only in the separate
+// instrumented oracle checkout.
+func traceSourceOrientation(phase string, root *layoutgraph.Node, details map[string]interface{}) {
+	if os.Getenv("TALA_TRACE_PLACEMENT") == "" {
+		return
+	}
+	rootID := "top"
+	if root != nil {
+		rootID = root.DebugID()
+	}
+	if target := os.Getenv("TALA_TRACE_PLACEMENT_ROOT"); target != "" && target != rootID {
+		return
+	}
+	event := map[string]interface{}{"event": "source-orientation", "phase": phase, "root": rootID}
+	for key, value := range details {
+		event[key] = value
+	}
+	if phase == "enter" && root != nil && os.Getenv("TALA_TRACE_SOURCE_ORIENTATION_EDGES") != "" {
+		rootEdges := make([]map[string]interface{}, 0, len(root.Edges))
+		for index, edge := range root.Edges {
+			if edge == nil {
+				rootEdges = append(rootEdges, map[string]interface{}{"index": index, "nil": true})
+				continue
+			}
+			directedFrom, directedTo, ok := edge.DirectedEndpoints()
+			directedFromID, directedToID := "", ""
+			if directedFrom != nil {
+				directedFromID = directedFrom.DebugID()
+			}
+			if directedTo != nil {
+				directedToID = directedTo.DebugID()
+			}
+			rootEdges = append(rootEdges, map[string]interface{}{
+				"index": index, "from": edge.From.DebugID(), "to": edge.To.DebugID(),
+				"directed_from": directedFromID, "directed_to": directedToID, "directed": ok,
+			})
+		}
+		event["root_edge_details"] = rootEdges
+	}
+	encoded, err := json.Marshal(event)
+	if err == nil {
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
