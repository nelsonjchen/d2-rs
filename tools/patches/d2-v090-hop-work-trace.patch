+
+func TestCodexReorderDuplicatesTreatsSignedZeroAsEqual(t *testing.T) {
+	graph, edges := newDuplicateEdgeTestGraph()
+	edges[0].Points = []*geo.Point{geo.NewPoint(math.Copysign(0, -1), 40), geo.NewPoint(0, 200)}
+	edges[1].Points = []*geo.Point{geo.NewPoint(0, 40), geo.NewPoint(math.Copysign(0, -1), 200)}
+	edges[2].Points = []*geo.Point{geo.NewPoint(-1, 40), geo.NewPoint(-1, 200)}
+	wantStart := edges[0].Points[0]
+	wantEnd := edges[0].Points[1]
