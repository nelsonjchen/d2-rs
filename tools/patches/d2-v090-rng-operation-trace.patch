+	return random
 }
+
+// Diagnostic operations retain semantic calls, floating-point bits and shuffle
+// swap order in addition to the legacy primitive draw observer. Pointer keys
+// stay inside this registry and are never emitted.
+var operationSources sync.Map
+
+func rngOperation(random *rand.Rand, operation string, fields map[string]any) {
+	if os.Getenv("D2_TRACE_RNG_OPERATIONS") == "" {
+		return
+	}
+	value, ok := operationSources.Load(random)
+	if !ok {
+		return
+	}
+	s := value.(*source)
+	event := map[string]any{"event": "rng-operation", "stream": s.stream,
+		"operation": operation, "draw_count": s.draws}
+	if s.stream == "node-placement" {
+		event["stream_id"] = s.streamID
+	}
+	for key, value := range fields {
+		event[key] = value
+	}
+	if encoded, err := json.Marshal(event); err == nil {
+		fmt.Fprintln(os.Stderr, string(encoded))
+	}
+}
+
+func rngDrawCount(random *rand.Rand) uint64 {
+	if value, ok := operationSources.Load(random); ok {
+		return value.(*source).draws
+	}
+	return 0
+}
+
+func Float64(random *rand.Rand) float64 {
+	before := rngDrawCount(random)
+	value := random.Float64()
+	rngOperation(random, "float64", map[string]any{"draw_count_before": before,
+		"result_bits": fmt.Sprintf("%016x", math.Float64bits(value))})
+	return value
+}
+
+func Int63(random *rand.Rand) int64 {
+	before := rngDrawCount(random)
+	value := random.Int63()
+	rngOperation(random, "int63-result", map[string]any{"draw_count_before": before,
+		"result": fmt.Sprintf("%d", value)})
+	return value
+}
+
+func ShuffleBegin(random *rand.Rand, length int) {
+	rngOperation(random, "shuffle-start", map[string]any{"length": length})
+}
+func ShuffleSwap(random *rand.Rand, index, target int) {
+	rngOperation(random, "shuffle-swap", map[string]any{"index": index, "target": target})
+}
+func ShuffleEnd(random *rand.Rand, length int, completed bool) {
+	rngOperation(random, "shuffle-end", map[string]any{"length": length, "completed": completed})
+}
+func Shuffle(random *rand.Rand, length int, swap func(int, int)) {
+	ShuffleBegin(random, length)
+	random.Shuffle(length, func(index, target int) {
+		ShuffleSwap(random, index, target)
+		swap(index, target)
+	})
+	ShuffleEnd(random, length, true)
+}
