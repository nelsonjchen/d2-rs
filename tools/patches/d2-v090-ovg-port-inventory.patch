 func traceOVGImportStage(g *layoutgraph.Graph, ovg *OVG, stage string) {
  if os.Getenv("D2_TRACE_OVG_STAGE_SCOPE") != fmt.Sprintf("%d:%d",len(g.Nodes),len(g.Edges)) { return }
+ if stage == "base" {
+  inventory := make([]map[string]any, 0, len(g.Nodes))
+  for _, node := range g.Nodes {
+   ports := make([][]string, 0, len(ovg.Ports[node]))
+   for _, port := range ovg.Ports[node] { ports = append(ports, []string{fmt.Sprintf("%016x",math.Float64bits(port.Point.X)),fmt.Sprintf("%016x",math.Float64bits(port.Point.Y))}) }
+   parent := int64(0); if node.Container != nil { parent = int64(node.Container.ID) }
+   inventory = append(inventory,map[string]any{"node":node.ID,"parent":parent,"fixed":node.FixedTopLeft != nil,"rect":[]string{fmt.Sprintf("%016x",math.Float64bits(node.TopLeft.X)),fmt.Sprintf("%016x",math.Float64bits(node.TopLeft.Y)),fmt.Sprintf("%016x",math.Float64bits(node.Width)),fmt.Sprintf("%016x",math.Float64bits(node.Height))},"ports":ports})
+  }
+  data,_:=json.Marshal(map[string]any{"event":"ovg-port-inventory","scope_nodes":len(g.Nodes),"scope_edges":len(g.Edges),"nodes":inventory});fmt.Fprintln(os.Stderr,string(data))
+ }
  edges:=make([][]string,0,len(ovg.Edges))
  for _,e:=range ovg.Edges { kind:="other"; if e.isVertical() {kind="vertical"} else if e.isHorizontal() {kind="horizontal"}; edges=append(edges,[]string{kind,fmt.Sprintf("%016x",math.Float64bits(e.From.X)),fmt.Sprintf("%016x",math.Float64bits(e.From.Y)),fmt.Sprintf("%016x",math.Float64bits(e.To.X)),fmt.Sprintf("%016x",math.Float64bits(e.To.Y))}) }
  data,_:=json.Marshal(map[string]any{"event":"ovg-import-stage","stage":stage,"scope_nodes":len(g.Nodes),"scope_edges":len(g.Edges),"edges":edges}); fmt.Fprintln(os.Stderr,string(data))
