+// Development observer: edge state before icons/node/edge label placement.
+func traceLabelPlacementInput(g *layoutgraph.Graph) {
+    if os.Getenv("D2_TRACE_LABEL_PLACEMENT") != "1" { return }
+    var snapshot strings.Builder
+    fmt.Fprintf(&snapshot, "LABEL_PLACEMENT begin nodes=%d edges=%d\n", len(g.Nodes), len(g.Edges))
+    for _, edge := range g.Edges {
+        if edge.Label == nil { continue }
+        points := make([]string, 0, len(edge.Points))
+        for _, p := range edge.Points { points = append(points, fmt.Sprintf("%016x,%016x", math.Float64bits(p.X), math.Float64bits(p.Y))) }
+        fmt.Fprintf(&snapshot, "LABEL_PLACEMENT edge=%d from=%d to=%d position=%s percentage=%016x fixed=%t points=%s\n", edge.ID, edge.From.IDValue(), edge.To.IDValue(), edge.Label.Position.String(), math.Float64bits(edge.LabelPercentage), edge.Label.PositionFixed(), strings.Join(points, ";"))
+    }
+    fmt.Fprintln(&snapshot, "LABEL_PLACEMENT end")
+    fmt.Fprint(os.Stderr, snapshot.String())
+}
