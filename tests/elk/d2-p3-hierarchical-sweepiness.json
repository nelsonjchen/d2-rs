{
  "id": "root",
  "layoutOptions": {
    "elk.algorithm": "layered",
    "elk.direction": "RIGHT",
    "elk.hierarchyHandling": "INCLUDE_CHILDREN",
    "elk.padding": "[top=0,left=0,bottom=0,right=0]",
    "org.eclipse.elk.layered.spacing.nodeNodeBetweenLayers": 70,
    "spacing.edgeNodeBetweenLayers": 40,
    "elk.layered.considerModelOrder.strategy": "NODES_AND_EDGES",
    "elk.layered.cycleBreaking.strategy": "GREEDY_MODEL_ORDER"
  },
  "children": [
    {
      "id": "container",
      "width": 80,
      "height": 60,
      "children": [
        {"id": "a", "width": 30, "height": 20},
        {"id": "b", "width": 30, "height": 20}
      ]
    },
    {"id": "z", "width": 40, "height": 30}
  ],
  "edges": [
    {"id": "a-to-z", "sources": ["a"], "targets": ["z"], "container": "root"},
    {"id": "b-to-z", "sources": ["b"], "targets": ["z"], "container": "root"}
  ]
}
