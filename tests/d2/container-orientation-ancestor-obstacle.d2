outer: {
  direction: down

  source: {
    a -> b
    b -> c
    c -> d
    d -> a
    b -> a
    a -> c
  }

  source -> outside_a
  source -> outside_b
  source -> outside_c

  outside_a.shape: circle
  outside_b.shape: cloud
  outside_c.shape: diamond

  fixed_obstacle: {
    top: 100
    left: 900
    label: fixed
  }
}
