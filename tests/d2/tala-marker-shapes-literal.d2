# Covers every author-reachable marker shape at both connection ends.
# The final none row is an explicit no-marker control.

arrow_source: "" {width: 60; height: 40; left: 0; top: 0}
arrow_target: "" {width: 60; height: 40; left: 200; top: 0}
arrow_source <-> arrow_target: {
  style.stroke: "red"
  source-arrowhead: {
    shape: arrow
  }
  target-arrowhead: {
    shape: arrow
  }
}

triangle_source: "" {width: 60; height: 40; left: 0; top: 90}
triangle_target: "" {width: 60; height: 40; left: 200; top: 90}
triangle_source <-> triangle_target: {
  style.stroke: "#0D32B2"
  source-arrowhead: {
    shape: triangle
  }
  target-arrowhead: {
    shape: triangle
  }
}

unfilled_triangle_source: "" {width: 60; height: 40; left: 0; top: 180}
unfilled_triangle_target: "" {width: 60; height: 40; left: 200; top: 180}
unfilled_triangle_source <-> unfilled_triangle_target: {
  style.stroke: "red"
  source-arrowhead: {
    shape: triangle
    style.filled: false
  }
  target-arrowhead: {
    shape: triangle
    style.filled: false
  }
}

