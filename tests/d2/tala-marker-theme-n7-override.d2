# Hollow interiors follow N7; matching literal and symbolic strokes remain distinct.

vars: {
  d2-config: {
    theme-id: 0
    theme-overrides: { B1: "#236745"; N7: "#123456" }
  }
}

symbolic_triangle_source: "" {width: 60; height: 40; left: 0; top: 0}
symbolic_triangle_target: "" {width: 60; height: 40; left: 200; top: 0}
symbolic_triangle_source <-> symbolic_triangle_target: {
  source-arrowhead: {
    shape: triangle
  }
  target-arrowhead: {
    shape: triangle
  }
}

literal_triangle_source: "" {width: 60; height: 40; left: 0; top: 90}
literal_triangle_target: "" {width: 60; height: 40; left: 200; top: 90}
literal_triangle_source <-> literal_triangle_target: {
  style.stroke: "#236745"
  source-arrowhead: {
    shape: triangle
  }
  target-arrowhead: {
    shape: triangle
  }
}

circle_source: "" {width: 60; height: 40; left: 0; top: 180}
circle_target: "" {width: 60; height: 40; left: 200; top: 180}
circle_source <-> circle_target: {
  source-arrowhead: {
    shape: circle
  }
  target-arrowhead: {
    shape: circle
  }
}

literal_circle_source: "" {width: 60; height: 40; left: 0; top: 270}
literal_circle_target: "" {width: 60; height: 40; left: 200; top: 270}
literal_circle_source <-> literal_circle_target: {
  style.stroke: "#236745"
  source-arrowhead: {
    shape: circle
  }
  target-arrowhead: {
    shape: circle
  }
}

diamond_source: "" {width: 60; height: 40; left: 0; top: 360}
diamond_target: "" {width: 60; height: 40; left: 200; top: 360}
diamond_source <-> diamond_target: {
  source-arrowhead: {
    shape: diamond
  }
  target-arrowhead: {
    shape: diamond
  }
}

cross_source: "" {width: 60; height: 40; left: 0; top: 450}
cross_target: "" {width: 60; height: 40; left: 200; top: 450}
cross_source <-> cross_target: {
  source-arrowhead: {
    shape: cross
  }
  target-arrowhead: {
    shape: cross
  }
}

cf_one_source: "" {width: 60; height: 40; left: 0; top: 540}
cf_one_target: "" {width: 60; height: 40; left: 200; top: 540}
cf_one_source <-> cf_one_target: {
  source-arrowhead: {
    shape: cf-one
  }
  target-arrowhead: {
    shape: cf-one
  }
}

cf_many_required_source: "" {width: 60; height: 40; left: 0; top: 630}
cf_many_required_target: "" {width: 60; height: 40; left: 200; top: 630}
cf_many_required_source <-> cf_many_required_target: {
  source-arrowhead: {
    shape: cf-many-required
  }
  target-arrowhead: {
    shape: cf-many-required
  }
}

